# Supabase Database & Realtime Configuration
# Lấy các thông tin này từ Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Google Sheet RSVP Webhook URL (Google Apps Script Web App Deployment)
# Hướng dẫn tạo webhook có sẵn trong SupabaseModal hoặc docs/
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/your-script-id/exec"
