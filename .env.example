# Supabase Database & Realtime Configuration (Dùng cho Sổ lưu bút & Lưu trữ an toàn)
# Lấy từ Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Google Sheets Service Account (v4 API) - Ghi nhận trực tiếp dữ liệu khách mời
# Lấy từ file credentials JSON tải từ Google Cloud Console > IAM & Admin > Service Accounts > Keys
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-with-escaped-newlines\n-----END PRIVATE KEY-----\n"

# ID bảng tính Google Sheet (chuỗi ký tự nằm giữa /d/ và /edit trên link Google Sheet của bạn)
GOOGLE_SHEET_ID="your-google-sheet-id"

# Tên tab trang tính muốn ghi dữ liệu vào (mặc định để trống sẽ tự động ghi vào tab đầu tiên)
GOOGLE_SHEET_NAME="RSVP"
