      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Gift, Copy, Check, QrCode, Heart } from \'lucide-react\';\nimport { WeddingCouple } from \'../types/wedding\';\n\ninterface GiftBoxProps {\n  couple: WeddingCouple;\n}\n\nexport const GiftBox: React.FC<GiftBoxProps> = ({ couple }) => {\n  const [copiedGroom, setCopiedGroom] = useState(false);\n  const [copiedBride, setCopiedBride] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'groom\' | \'bride\'>(\'groom\');\n\n  const handleCopy = (text: string, type: \'groom\' | \'bride\') => {\n    navigator.clipboard.writeText(text);\n    if (type === \'groom\') {\n      setCopiedGroom(true);\n      setTimeout(() => setCopiedGroom(false), 2500);\n    } else {\n      setCopiedBride(true);\n      setTimeout(() => setCopiedBride(false), 2500);\n    }\n  };\n\n  return (\n    <section id=\"gift\" className=\"py-20 sm:py-28 bg-[#F5F2EB] px-4 sm:px-6\">\n      <div className=\"max-w-4xl mx-auto\">\n        {/* Section Header */}\n        <div className=\"text-center mb-12 sm:mb-16\">\n          <p className=\"font-script text-2xl sm:text-3xl text-rose-600 mb-1\">\n            Wedding Gift\n          </p>\n          <h2 className=\"font-serif text-3xl sm:text-5xl font-bold text-stone-900 tracking-tight text-balance\">\n            H\341\273\231p M\341\273\253ng H\341\272\241nh Ph\303\272c\n          </h2>\n          <div className=\"mt-4 flex items-center justify-center gap-3\">\n            <div className=\"h-px w-12 bg-rose-300\" />\n            <Gift className=\"w-4 h-4 text-rose-500\" />\n            <div className=\"h-px w-12 bg-rose-300\" />\n          </div>\n          <p className=\"mt-4 text-sm sm:text-base text-stone-600 max-w-lg mx-auto\">\n            S\341\273\261 hi\341\273\207n di\341\273\207n v\303\240 l\341\273\235i ch\303\272c ph\303\272c c\341\273\247a Qu\303\275 kh\303\241ch l\303\240 m\303\263n qu\303\240 \303\275 ngh\304\251a nh\341\272\245t. N\341\272\277u mu\341\273\221n g\341\273\255i t\341\272\267ng m\341\273\231t m\303\263n qu\303\240 m\341\273\253ng t\341\273\253 xa, Qu\303\275 kh\303\241ch c\303\263 th\341\273\203 g\341\273\255i t\341\273\233i h\341\273\231p m\341\273\253ng d\306\260\341\273\233i \304\221\303\242y.\n          </p>\n        </div>\n\n        {/* Tab switch for mobile view */}\n        <div className=\"flex md:hidden items-center justify-center gap-2 p-1.5 bg-stone-200/70 rounded-xl max-w-xs mx-auto mb-8\">\n          <button\n            onClick={() => setActiveTab(\'groom\')}\n            className={`flex-1 py-2 text-xs font-semibold rounded-lg transition-all ${\n              activeTab === \'groom\' ? \'bg-white text-stone-900 shadow-xs\' : \'text-stone-600\'\n            }`}\n          >\n            M\341\273\253ng Ch\303\272 R\341\273\203\n          </button>\n          <button\n            onClick={() => setActiveTab(\'bride\')}\n            className={`flex-1 py-2 text-xs font-semibold rounded-lg transition-all ${\n              activeTab === \'bride\' ? \'bg-white text-stone-900 shadow-xs\' : \'text-stone-600\'\n            }`}\n          >\n            M\341\273\253ng C\303\264 D\303\242u\n          </button>\n        </div>\n\n        {/* Banking Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          {/* Ch\303\272 R\341\273\203 Card */}\n          <div\n            className={`bg-white rounded-3xl p-6 sm:p-8 border border-stone-200 shadow-xs flex flex-col items-center text-center transition-all ${\n              activeTab === \'groom\' ? \'block\' : \'hidden md:flex\'\n            }`}\n          >\n            <div className=\"w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mb-3\">\n              <QrCode className=\"w-6 h-6\" />\n            </div>\n\n            <span className=\"text-xs uppercase tracking-widest text-rose-600 font-semibold mb-1\">\n              CH\303\232 R\341\273\202\n            </span>\n            <h3 className=\"font-serif text-2xl font-bold text-stone-900 mb-4\">\n              {couple.groom.fullName}\n            </h3>\n\n            {/* QR Code Container */}\n            <div className=\"p-3 bg-stone-50 rounded-2xl border border-stone-200 mb-6 w-52 h-52 flex items-center justify-center\">\n              <img\n                src={couple.groom.bankInfo?.qrCodeUrl}\n                alt=\"QR M\341\273\253ng C\306\260\341\273\233i Ch\303\272 R\341\273\203\"\n                referrerPolicy=\"no-referrer\"\n                loading=\"lazy\"\n                className=\"w-full h-full object-contain rounded-xl\"\n                onError={(e) => {\n                  const target = e.currentTarget;\n                  target.style.display = \'none\';\n                  const parent = target.parentElement;\n                  if (parent) {\n                    parent.innerHTML = `\n                      <div class=\"text-xs text-stone-500 flex flex-col items-center\">\n                        <span class=\"font-bold text-stone-800\">VietQR</span>\n                        <span>Qu\303\251t m\303\243 chuy\341\273\203n kho\341\272\243n</span>\n                      </div>\n                    `;\n                  }\n                }}\n              />\n            </div>\n\n            {/* Bank details */}\n            <div className=\"w-full bg-stone-50 rounded-2xl p-4 border border-stone-100 text-left text-sm space-y-2 mb-4\">\n              <div>\n                <span className=\"text-xs text-stone-400 block\">Ng\303\242n h\303\240ng</span>\n                <strong className=\"text-stone-800 font-medium\">{couple.groom.bankInfo?.bankName}</strong>\n              </div>\n              <div>\n                <span className=\"text-xs text-stone-400 block\">Ch\341\273\247 t\303\240i kho\341\272\243n</span>\n                <strong className=\"text-stone-800 font-medium\">{couple.groom.bankInfo?.accountName}</strong>\n              </div>\n              <div className=\"flex items-center justify-between pt-1\">\n                <div>\n                  <span className=\"text-xs text-stone-400 block\">S\341\273\221 t\303\240i kho\341\272\243n</span>\n                  <span className=\"font-mono text-base font-bold text-stone-900 tracking-wider\">\n                    {couple.groom.bankInfo?.accountNumber}\n                  </span>\n                </div>\n                <button\n                  onClick={() => handleCopy(couple.groom.bankInfo?.accountNumber || \'\', \'groom\')}\n                  className=\"p-2 rounded-lg bg-white border border-stone-200 text-stone-700 hover:bg-stone-100 transition-colors\"\n                  title=\"Sao ch\303\251p s\341\273\221 t\303\240i kho\341\272\243n\"\n                >\n                  {copiedGroom ? <Check className=\"w-4 h-4 text-emerald-600\" /> : <Copy className=\"w-4 h-4\" />}\n                </button>\n              </div>\n            </div>\n\n            {copiedGroom && (\n              <span className=\"text-xs text-emerald-600 font-medium\">\n                \304\220\303\243 sao ch\303\251p s\341\273\221 t\303\240i kho\341\272\243n v\303\240o b\341\273\231 nh\341\273\233 t\341\272\241m!\n              </span>\n            )}\n          </div>\n\n          {/* C\303\264 D\303\242u Card */}\n          <div\n            className={`bg-white rounded-3xl p-6 sm:p-8 border border-stone-200 shadow-xs flex flex-col items-center text-center transition-all ${\n              activeTab === \'bride\' ? \'block\' : \'hidden md:flex\'\n            }`}\n          >\n            <div className=\"w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mb-3\">\n              <QrCode className=\"w-6 h-6\" />\n            </div>\n\n            <span className=\"text-xs uppercase tracking-widest text-rose-600 font-semibold mb-1\">\n              C\303\224 D\303\202U\n            </span>\n            <h3 className=\"font-serif text-2xl font-bold text-stone-900 mb-4\">\n              {couple.bride.fullName}\n            </h3>\n\n            {/* QR Code Container */}\n            <div className=\"p-3 bg-stone-50 rounded-2xl border border-stone-200 mb-6 w-52 h-52 flex items-center justify-center\">\n              <img\n                src={couple.bride.bankInfo?.qrCodeUrl}\n                alt=\"QR M\341\273\253ng C\306\260\341\273\233i C\303\264 D\303\242u\"\n                referrerPolicy=\"no-referrer\"\n                loading=\"lazy\"\n                className=\"w-full h-full object-contain rounded-xl\"\n                onError={(e) => {\n                  const target = e.currentTarget;\n                  target.style.display = \'none\';\n                  const parent = target.parentElement;\n                  if (parent) {\n                    parent.innerHTML = `\n                      <div class=\"text-xs text-stone-500 flex flex-col items-center\">\n                        <span class=\"font-bold text-stone-800\">VietQR</span>\n                        <span>Qu\303\251t m\303\243 chuy\341\273\203n kho\341\272\243n</span>\n                      </div>\n                    `;\n                  }\n                }}\n              />\n            </div>\n\n            {/* Bank details */}\n            <div className=\"w-full bg-stone-50 rounded-2xl p-4 border border-stone-100 text-left text-sm space-y-2 mb-4\">\n              <div>\n                <span className=\"text-xs text-stone-400 block\">Ng\303\242n h\303\240ng</span>\n                <strong className=\"text-stone-800 font-medium\">{couple.bride.bankInfo?.bankName}</strong>\n              </div>\n              <div>\n                <span className=\"text-xs text-stone-400 block\">Ch\341\273\247 t\303\240i kho\341\272\243n</span>\n                <strong className=\"text-stone-800 font-medium\">{couple.bride.bankInfo?.accountName}</strong>\n              </div>\n              <div className=\"flex items-center justify-between pt-1\">\n                <div>\n           