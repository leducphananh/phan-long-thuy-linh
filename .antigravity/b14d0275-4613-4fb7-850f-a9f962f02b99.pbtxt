  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-serif: \'Playfair Display\', Georgia, serif;\n    --font-script: \'Alex Brush\', cursive;\n    --font-cormorant: \'Cormorant Garamond\', Georgia, serif;\n    --font-sans: \'Montserrat\', system-ui, -apple-system, sans-serif;\n  }\n}\n\n.font-serif {\n  font-family: var(--font-serif);\n}\n\n.font-script {\n  font-family: var(--font-script);\n}\n\n.font-cormorant {\n  font-family: var(--font-cormorant);\n}\n\n.font-sans {\n  font-family: var(--font-sans);\n}\n\n/* Custom romantic decorative utilities */\n.bg-romantic-pattern {\n  background-color: #FAF8F5;\n  background-image: radial-gradient(rgba(217, 119, 87, 0.05) 1px, transparent 1px),\n                    radial-gradient(rgba(217, 119, 87, 0.05) 1px, #FAF8F5 1px);\n  background-size: 40px 40px;\n  background-position: 0 0, 20px 20px;\n}\n\n/* Smooth heart floating animation */\n@keyframes floatPetal {\n  0% {\n    transform: translateY(0px) rotate(0deg) scale(0.9);\n    opacity: 0;\n  }\n  15% {\n    opacity: 0.8;\n  }\n  85% {\n    opacity: 0.8;\n  }\n  100% {\n    transform: translateY(100vh) rotate(360deg) scale(1.1);\n    opacity: 0;\n  }\n}\n\n.animate-petal {\n  animation: floatPetal 12s linear infinite;\n}\n\n/* Clean custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: #f5f2ed;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #d6cec7;\n  border-radius: 9999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #b8aba2;\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
