    end_line: 54
    content: "import React from \'react\';\nimport { Heart, ArrowUp, Sparkles } from \'lucide-react\';\nimport { WeddingCouple } from \'../types/wedding\';\n\ninterface FooterProps {\n  couple: WeddingCouple;\n}\n\nexport const Footer: React.FC<FooterProps> = ({ couple }) => {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"bg-stone-900 text-stone-300 py-16 px-4 sm:px-6 relative overflow-hidden border-t border-stone-800\">\n      <div className=\"max-w-4xl mx-auto text-center relative z-10 flex flex-col items-center\">\n        {/* Monogram */}\n        <div className=\"w-14 h-14 rounded-full border border-rose-500/40 flex items-center justify-center font-serif text-2xl text-rose-300 mb-6 bg-stone-800/50\">\n          N&amp;L\n        </div>\n\n        <h3 className=\"font-serif text-2xl sm:text-4xl font-bold text-white tracking-wide\">\n          {couple.groom.name} &amp; {couple.bride.name}\n        </h3>\n\n        <p className=\"font-script text-2xl sm:text-3xl text-rose-400 mt-2\">\n          Thank you for celebrating with us!\n        </p>\n\n        <p className=\"mt-4 text-xs sm:text-sm text-stone-400 max-w-md leading-relaxed font-sans\">\n          C\341\272\243m \306\241n v\303\254 \304\221\303\243 l\303\240 m\341\273\231t ph\341\272\247n \304\221\341\272\267c bi\341\273\207t trong ng\303\240y tr\341\273\215ng \304\221\341\272\241i v\303\240 trong su\341\273\221t h\303\240nh tr\303\254nh thanh xu\303\242n c\341\273\247a ch\303\272ng m\303\254nh.\n        </p>\n\n        {/* Scroll To Top Button */}\n        <button\n          onClick={scrollToTop}\n          className=\"mt-8 p-3 rounded-full bg-stone-800 hover:bg-stone-700 text-stone-300 hover:text-white transition-all transform hover:-translate-y-1 shadow-md border border-stone-700\"\n          aria-label=\"Cu\341\273\231n l\303\252n \304\221\341\272\247u trang\"\n        >\n          <ArrowUp className=\"w-4 h-4\" />\n        </button>\n\n        {/* Copyright notice */}\n        <div className=\"mt-12 pt-6 border-t border-stone-800/80 w-full text-center text-xs text-stone-500 flex flex-col sm:flex-row items-center justify-center gap-2\">\n          <span>&copy; 2026 Wedding Invitation \302\267 H\341\272\243i Nam &amp; Kh\303\241nh Linh.</span>\n          <span className=\"hidden sm:inline\">\302\267</span>\n          <span className=\"flex items-center gap-1 text-stone-400\">\n            Tr\341\273\215n v\341\272\271n t\303\254nh y\303\252u &amp; h\341\272\241nh ph\303\272c vi\303\252n m\303\243n\n          </span>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    raw_content: "import React from \'react\';\nimport { Heart, ArrowUp, Sparkles } from \'lucide-react\';\nimport { WeddingCouple } from \'../types/wedding\';\n\ninterface FooterProps {\n  couple: WeddingCouple;\n}\n\nexport const Footer: React.FC<FooterProps> = ({ couple }) => {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"bg-stone-900 text-stone-300 py-16 px-4 sm:px-6 relative overflow-hidden border-t border-stone-800\">\n      <div className=\"max-w-4xl mx-auto text-center relative z-10 flex flex-col items-center\">\n        {/* Monogram */}\n        <div className=\"w-14 h-14 rounded-full border border-rose-500/40 flex items-center justify-center font-serif text-2xl text-rose-300 mb-6 bg-stone-800/50\">\n          N&amp;L\n        </div>\n\n        <h3 className=\"font-serif text-2xl sm:text-4xl font-bold text-white tracking-wide\">\n          {couple.groom.name} &amp; {couple.bride.name}\n        </h3>\n\n        <p className=\"font-script text-2xl sm:text-3xl text-rose-400 mt-2\">\n          Thank you for celebrating with us!\n        </p>\n\n        <p className=\"mt-4 text-xs sm:text-sm text-stone-400 max-w-md leading-relaxed font-sans\">\n          C\341\272\243m \306\241n v\303\254 \304\221\303\243 l\303\240 m\341\273\231t ph\341\272\247n \304\221\341\272\267c bi\341\273\207t trong ng\303\240y tr\341\273\215ng \304\221\341\272\241i v\303\240 trong su\341\273\221t h\303\240nh tr\303\254nh thanh xu\303\242n c\341\273\247a ch\303\272ng m\303\254nh.\n        </p>\n\n        {/* Scroll To Top Button */}\n        <button\n          onClick={scrollToTop}\n          className=\"mt-8 p-3 rounded-full bg-stone-800 hover:bg-stone-700 text-stone-300 hover:text-white transition-all transform hover:-translate-y-1 shadow-md border border-stone-700\"\n          aria-label=\"Cu\341\273\231n l\303\252n \304\221\341\272\247u trang\"\n        >\n          <ArrowUp className=\"w-4 h-4\" />\n        </button>\n\n        {/* Copyright notice */}\n        <div className=\"mt-12 pt-6 border-t border-stone-800/80 w-full text-center text-xs text-stone-500 flex flex-col sm:flex-row items-center justify-center gap-2\">\n          <span>&copy; 2026 Wedding Invitation \302\267 H\341\272\243i Nam &amp; Kh\303\241nh Linh.</span>\n          <span className=\"hidden sm:inline\">\302\267</span>\n          <span className=\"flex items-center gap-1 text-stone-400\">\n            Tr\341\273\215n v\341\272\271n t\303\254nh y\303\252u &amp; h\341\272\241nh ph\303\272c vi\303\252n m\303\243n\n          </span>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
