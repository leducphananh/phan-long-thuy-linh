      arguments_json: "{\"CodeContent\":\"import { WeddingCouple, StoryMilestone, WeddingEvent, GalleryPhoto } from \'../types/wedding\';\\n\\nexport const weddingCoupleData: WeddingCouple = {\\n  groom: {\\n    name: \'H\341\272\243i Nam\',\\n    fullName: \'Nguy\341\273\205n H\341\272\243i Nam\',\\n    title: \'Ch\303\272 R\341\273\203\',\\n    fatherName: \'Nguy\341\273\205n V\304\203n Minh\',\\n    motherName: \'L\303\252 Th\341\273\213 Thu H\303\240\',\\n    address: \'Qu\341\272\255n Ba \304\220\303\254nh, TP. H\303\240 N\341\273\231i\',\\n    phone: \'0912 345 678\',\\n    bankInfo: {\\n      bankName: \'Vietcombank - Chi nh\303\241nh Th\304\203ng Long\',\\n      accountNumber: \'1029384756\',\\n      accountName: \'NGUYEN HAI NAM\',\\n      qrCodeUrl: \'https://img.vietqr.io/image/VCB-1029384756-compact2.png?amount=0&addInfo=Mung%20cuoi%20Hai%20Nam%20Khanh%20Linh&accountName=NGUYEN%20HAI%20NAM\'\\n    }\\n  },\\n  bride: {\\n    name: \'Kh\303\241nh Linh\',\\n    fullName: \'Tr\341\272\247n Kh\303\241nh Linh\',\\n    title: \'C\303\264 D\303\242u\',\\n    fatherName: \'Tr\341\272\247n Quang D\305\251ng\',\\n    motherName: \'Ph\341\272\241m Thanh Mai\',\\n    address: \'Qu\341\272\255n 1, TP. H\341\273\223 Ch\303\255 Minh\',\\n    phone: \'0987 654 321\',\\n    bankInfo: {\\n      bankName: \'Techcombank - Chi nh\303\241nh B\341\272\277n Th\303\240nh\',\\n      accountNumber: \'19038472910015\',\\n      accountName: \'TRAN KHANH LINH\',\\n      qrCodeUrl: \'https://img.vietqr.io/image/TCB-19038472910015-compact2.png?amount=0&addInfo=Mung%20cuoi%20Hai%20Nam%20Khanh%20Linh&accountName=TRAN%20KHANH%20LINH\'\\n    }\\n  },\\n  // Wedding date: 28th November 2026, 18:00\\n  weddingDate: \'2026-11-28T18:00:00+07:00\',\\n  lunarDate: \'Ng\303\240y 20 th\303\241ng 10 n\304\203m B\303\255nh Ng\341\273\215\'\\n};\\n\\nexport const storyMilestones: StoryMilestone[] = [\\n  {\\n    id: \'story-1\',\\n    year: \'2021\',\\n    date: \'15 Th\303\241ng 10, 2021\',\\n    ti