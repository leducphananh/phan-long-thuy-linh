  code_action {
    action_spec {
      create_file {
        instruction: "import { createClient, SupabaseClient } from \'@supabase/supabase-js\';\nimport { RSVPFormData, GuestbookEntry } from \'../types/wedding\';\n\n// Key names in localStorage for custom runtime Supabase configuration\nconst STORAGE_URL_KEY = \'wedding_supabase_url\';\nconst STORAGE_ANON_KEY = \'wedding_supabase_anon_key\';\nconst LOCAL_RSVP_KEY = \'wedding_local_rsvp_data\';\nconst LOCAL_GUESTBOOK_KEY = \'wedding_local_guestbook_data\';\n\n// Initial sample guestbook wishes if local storage is empty\nconst INITIAL_GUESTBOOK_WISHES: GuestbookEntry[] = [\n  {\n    id: \'wish-1\',\n    created_at: new Date(Date.now() - 3600 * 1000 * 5).toISOString(),\n    name: \'Nguy\341\273\205n Minh Tu\341\272\245n & B\341\272\241n b\303\250 \304\220H\',\n    message: \'Ch\303\272c hai b\341\272\241n tr\304\203m n\304\203m h\341\272\241nh ph\303\272c, \304\221\341\272\247u b\341\272\241c r\304\203ng long! Ch\303\272c cho t\341\273\225 \341\272\245m nh\341\273\217 lu\303\264n tr\303\240n ng\341\272\255p ti\341\272\277ng c\306\260\341\273\235i v\303\240 y\303\252u th\306\260\306\241ng.\',\n    relationship: \'friend\',\n    avatar_color: \'rose\',\n    likes_count: 14,\n  },\n  {\n    id: \'wish-2\',\n    created_at: new Date(Date.now() - 3600 * 1000 * 12).toISOString(),\n    name: \'Ch\341\273\213 Mai Th\341\272\243o & Gia \304\221\303\254nh\',\n    message: \'M\341\273\253ng ng\303\240y vui c\341\273\247a hai em! Ch\303\272c hai em lu\303\264n \304\221\341\273\223ng h\303\240nh, th\341\272\245u hi\341\273\203u v\303\240 chia s\341\272\273 m\341\273\215i kho\341\272\243nh kh\341\272\257c ng\341\273\215t ng\303\240o b\303\252n nhau.\',\n    relationship: \'family\',\n    avatar_color: \'amber\',\n    likes_count: 9,\n  },\n  {\n    id: \'wish-3\',\n    created_at: new Date(Date.now() - 3600 * 1000 * 24).toISOString(),\n    name: \'\304\220\341\273\251c Huy & Team C\303\264ng Ngh\341\273\207\',\n    message: \'Ch\303\272c m\341\273\253ng anh Nam v\303\240 ch\341\273\213 Linh! \304\220\303\241m c\306\260\341\273\233i \304\221\341\272\271p nh\306\260 m\306\241, ch\303\272c hai v\341\273\243 ch\341\273\223ng s\341\273\233m c\303\263 qu\303\275 t\341\273\255 thi\303\252n th\341\272\247n nha!\',\n    relationship: \'colleague\',\n    avatar_color: \'emerald\',\n    likes_count: 18,\n  },\n  {\n    id: \'wish-4\',\n    created_at: new Date(Date.now() - 3600 * 1000 * 48).toISOString(),\n    name: \'B\303\241c Thanh & C\303\264 Li\303\252n\',\n    message: \'Ch\303\272c hai ch\303\241u tr\304\203m n\304\203m t\303\254nh vi\303\252n m\303\243n, b\341\272\241c \304\221\341\272\247u ngh\304\251a phu th\303\252. H\341\272\241nh ph\303\272c v\303\240 vi\303\252n m\303\243n tr\341\273\215n \304\221\341\273\235i!\',\n    relationship: \'relative\',\n    avatar_color: \'indigo\',\n    likes_count: 7,\n  }\n];\n\nexport function getSupabaseConfig(): { url: string; anonKey: string; isConfigured: boolean } {\n  const envUrl = (import.meta as any).env?.VITE_SUPABASE_URL || \'\';\n  const envKey = (import.meta as any).env?.VITE_SUPABASE_ANON_KEY || \'\';\n  \n  const storedUrl = typeof window !== \'undefined\' ? localStorage.getItem(STORAGE_URL_KEY) || \'\' : \'\';\n  const storedKey = typeof window !== \'undefined\' ? localStorage.getItem(STORAGE_ANON_KEY) || \'\' : \'\';\n\n  const activeUrl = storedUrl || envUrl;\n  const activeKey = storedKey || envKey;\n\n  const isConfigured = Boolean(\n    activeUrl && \n    activeKey && \n    activeUrl.startsWith(\'https://\') &&\n    activeUrl.includes(\'supabase.co\')\n  );\n\n  return {\n    url: activeUrl,\n    anonKey: activeKey,\n    isConfigured,\n  };\n}\n\nexport function saveSupabaseConfig(url: string, anonKey: string) {\n  if (typeof window !== \'undefined\') {\n    if (url) localStorage.setItem(STORAGE_URL_KEY, url.trim());\n    else localStorage.removeItem(STORAGE_URL_KEY);\n\n    if (anonKey) localStorage.setItem(STORAGE_ANON_KEY, anonKey.trim());\n    else localStorage.removeItem(STORAGE_ANON_KEY);\n    \n    // Refresh client\n    cachedClient = null;\n  }\n}\n\nlet cachedClient: SupabaseClient | null = null;\n\nexport function getSupabaseClient(): SupabaseClient | null {\n  const { url, anonKey, isConfigured } = getSupabaseConfig();\n  if (!isConfigured) return null;\n\n  if (!cachedClient) {\n    try {\n      cachedClient = createClient(url, anonKey);\n    } catch (err) {\n      console.error(\'Failed to create Supabase client:\', err);\n      return null;\n    }\n  }\n  return cachedClient;\n}\n\n// ==================== RSVP SERVICES ====================\n\nexport async function submitRSVP(formData: RSVPFormData): Promise<{ success: boolean; message: string; mode: \'supabase\' | \'local\' }> {\n  const client = getSupabaseClient();\n\n  if (client) {\n    try {\n      const { error } = await client.from(\'rsvp\').insert([\n        {\n          name: formData.name.trim(),\n          phone: formData.phone.trim(),\n          attending: formData.attending,\n          guests_count: formData.guestsCount,\n          side: formData.side,\n          message: formData.message?.trim() || null,\n          dietary_requirements: formData.dietaryRequirements?.trim() || null,\n        }\n      ]);\n\n      if (error) {\n        console.error(\'Supabase RSVP insert error:\', error);\n        throw error;\n      }\n\n      return {\n        success: true,\n        message: \'\304\220\303\243 g\341\273\255i x\303\241c nh\341\272\255n tham d\341\273\261 th\303\240nh c\303\264ng v\303\240o Supabase!\',\n        mode: \'supabase\'\n      };\n    } catch (err: any) {\n      console.warn(\'Falling back to local storage due to Supabase error:\', err);\n      // Fallback below\n    }\n  }\n\n  // Local storage fallback\n  try {\n    const raw = localStorage.getItem(LOCAL_RSVP_KEY);\n    const list = raw ? JSON.parse(raw) : [];\n    const newEntry = {\n      ...formData,\n      id: \'rsvp-\' + Date.now(),\n      created_at: new Date().toISOString(),\n    };\n    list.unshift(newEntry);\n    localStorage.setItem(LOCAL_RSVP_KEY, JSON.stringify(list));\n\n    return {\n      success: true,\n      message: \'\304\220\303\243 ghi nh\341\272\255n x\303\241c nh\341\272\255n tham d\341\273\261 c\341\273\247a b\341\272\241n!\',\n      mode: \'local\'\n    };\n  } catch (err) {\n    return {\n      success: false,\n      message: \'Kh\303\264ng th\341\273\203 l\306\260u d\341\273\257 li\341\273\207u. Vui l\303\262ng th\341\273\255 l\341\272\241i sau.\',\n      mode: \'local\'\n    };\n  }\n}\n\n// ==================== GUESTBOOK SERVICES ====================\n\nexport async function fetchGuestbook(): Promise<{ data: GuestbookEntry[]; mode: \'supabase\' | \'local\' }> {\n  const client = getSupabaseClient();\n\n  if (client) {\n    try {\n      const { data, error } = await client\n        .from(\'guestbook\')\n        .select(\'*\')\n        .order(\'created_at\', { ascending: false })\n        .limit(100);\n\n      if (!error && data) {\n        return { data: data as GuestbookEntry[], mode: \'supabase\' };\n      }\n      console.warn(\'Supabase fetch error, fallback to local:\', error);\n    } catch (err) {\n      console.warn(\'Supabase fetch exception, fallback to local:\', err);\n    }\n  }\n\n  // Local fallback\n  try {\n    const raw = localStorage.getItem(LOCAL_GUESTBOOK_KEY);\n    if (!raw) {\n      localStorage.setItem(LOCAL_GUESTBOOK_KEY, JSON.stringify(INITIAL_GUESTBOOK_WISHES));\n      return { data: INITIAL_GUESTBOOK_WISHES, mode: \'local\' };\n    }\n    return { data: JSON.parse(raw), mode: \'local\' };\n  } catch (err) {\n    return { data: INITIAL_GUESTBOOK_WISHES, mode: \'local\' };\n  }\n}\n\nexport async function submitGuestbookWish(\n  name: string,\n  message: string,\n  relationship: string = \'friend\',\n  avatar_color: string = \'rose\'\n): Promise<{ success: boolean; entry: GuestbookEntry; mode: \'supabase\' | \'local\' }> {\n  const client = getSupabaseClient();\n\n  const newEntry: GuestbookEntry = {\n    id: \'wish-\' + Date.now(),\n    created_at: new Date().toISOString(),\n    name: name.trim(),\n    message: message.trim(),\n    relationship,\n    avatar_color,\n    likes_count: 0\n  };\n\n  if (client) {\n    try {\n      const { data, error } = await client\n        .from(\'guestbook\')\n        .insert([\n          {\n            name: newEntry.name,\n            message: newEntry.message,\n            relationship: newEntry.relationship,\n            avatar_color: newEntry.avatar_color,\n            likes_count: 0,\n          }\n        ])\n        .select()\n        .single();\n\n      if (!error && data) {\n        return {\n          success: true,\n          entry: data as GuestbookEntry,\n          mode: \'supabase\'\n        };\n      }\n      console.warn(\'Supabase insert guestbook error:\', error);\n    } catch (err) {\n      console.warn(\'Supabase insert exception, fallback to local:\', err);\n    }\n  }\n\n  // Local fallback\n  try {\n    const raw = localStorage.getItem(LOCAL_GUESTBOOK_KEY);\n    const list: GuestbookEntry[] = raw ? JSON.parse(raw) : [...INITIAL_GUESTBOOK_WISHES];\n    list.unshift(newEntry);\n    localStorage.setItem(LOCAL_GUESTBOOK_KEY, JSON.stringify(list));\n    return { success: true, entry: newEntry, mode: \'local\' };\n  } catch (err) {\n    return { success: false, entry: newEntry, mode: \'local\' };\n  }\n}\n\nexport async function likeGuestbookWish(id: string): Promise<boolean> {\n  const client = getSupabaseClient();\n\n  if (client) {\n    try {\n      // Try using the rpc function if defined, or simple update\n      const { error: rpcError } = await client.rpc(\'increment_guestbook_like\', { entry_id: id });\n      if (!rpcError) return true;\n\n      // Fallback to fetch + update if rpc not found\n      const { data } = await client.from(\'guestbook\').select(\'likes_count\').eq(\'id\', id).single();\n      if (data) {\n        const nextLikes = (data.likes_count || 0) + 1;\n        await client.from(\'guestbook\').update({ likes_count: nextLikes }).eq(\'id\', id);\n        return true;\n      }\n    } catch (err) {\n      console.warn(\'Supabase like error, using local fallback:\', err);\n    }\n  }\n\n  // Local fallback\n  try {\n    const raw = localStorage.getItem(LOCAL_GUESTBOOK_KEY);\n    if (raw) {\n      const list: GuestbookEntry[] = JSON.parse(raw);\n      const idx = list.findIndex(item => item.id === id);\n      if (idx !== -1) {\n        list[idx].likes_count = (list[idx].likes_count || 0) + 1;\n        localStorage.setItem(LOCAL_GUESTBOOK_KEY, JSON.stringify(list));\n        return true;\n      }\n    }\n  } catch (err) {\n    console.error(\'Local like error:\', err);\n  }\n  return false;\n}\n"
        path {
          absolute_uri: "file:///src/lib/supabase.ts"
        }
        overwrite: true
      }
    }
