            lines {
              text: "    try {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const date = new Date(isoString);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const now = new Date();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const diffMs = now.getTime() - date.getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const diffDays = Math.floor(diffHours / 24);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (diffHours < 1) return \'V\341\273\253a xong\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (diffHours < 24) return `${diffHours} gi\341\273\235 tr\306\260\341\273\233c`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (diffDays === 1) return \'H\303\264m qua\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return `${diffDays} ng\303\240y tr\306\260\341\273\233c`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    } catch {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
