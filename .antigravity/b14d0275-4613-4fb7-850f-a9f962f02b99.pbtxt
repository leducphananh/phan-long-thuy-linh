  code_action {
    action_spec {
      create_file {
        instruction: "-- =========================================================================\n-- WEDDING INVITATION DATABASE SCHEMA (SUPABASE POSTGRESQL DDL)\n-- D\341\273\261 \303\241n: Thi\341\273\207p C\306\260\341\273\233i Online (Wedding Invitation)\n-- H\306\260\341\273\233ng d\341\272\253n: Copy to\303\240n b\341\273\231 \304\221o\341\272\241n script n\303\240y d\303\241n v\303\240o Supabase SQL Editor v\303\240 b\341\272\245m Run.\n-- =========================================================================\n\n-- 1. B\341\272\242NG X\303\201C NH\341\272\254N THAM GIA (RSVP)\ncreate table if not exists public.rsvp (\n    id uuid default gen_random_uuid() primary key,\n    created_at timestamp with time zone default timezone(\'utc\'::text, now()) not null,\n    name text not null,\n    phone text not null,\n    attending boolean default true not null,\n    guests_count integer default 1 not null check (guests_count >= 1 and guests_count <= 10),\n    side text default \'both\' check (side in (\'groom\', \'bride\', \'both\')),\n    message text,\n    dietary_requirements text\n);\n\n-- K\303\255ch ho\341\272\241t Row Level Security (RLS) cho b\341\272\243ng rsvp\nalter table public.rsvp enable row level security;\n\n-- Policy: B\341\272\245t k\341\273\263 kh\303\241ch truy c\341\272\255p n\303\240o c\305\251ng c\303\263 th\341\273\203 g\341\273\255i form RSVP (Insert)\ncreate policy \"Allow public to submit RSVP\"\non public.rsvp\nfor insert\nto anon, authenticated\nwith check (true);\n\n-- Policy: Cho ph\303\251p \304\221\341\273\215c th\303\264ng tin RSVP (D\303\240nh cho c\303\264 d\303\242u ch\303\272 r\341\273\203 ho\341\272\267c th\341\273\221ng k\303\252)\ncreate policy \"Allow select RSVP\"\non public.rsvp\nfor select\nto anon, authenticated\nusing (true);\n\n-- 2. B\341\272\242NG S\341\273\224 L\306\257U B\303\232T & L\341\273\234I CH\303\232C (GUESTBOOK)\ncreate table if not exists public.guestbook (\n    id uuid default gen_random_uuid() primary key,\n    created_at timestamp with time zone default timezone(\'utc\'::text, now()) not null,\n    name text not null,\n    message text not null,\n    relationship text default \'friend\' check (relationship in (\'family\', \'friend\', \'colleague\', \'relative\', \'other\')),\n    avatar_color text default \'rose\',\n    likes_count integer default 0 not null check (likes_count >= 0)\n);\n\n-- K\303\255ch ho\341\272\241t Row Level Security (RLS) cho b\341\272\243ng guestbook\nalter table public.guestbook enable row level security;\n\n-- Policy: M\341\273\215i ng\306\260\341\273\235i \304\221\341\273\201u c\303\263 th\341\273\203 \304\221\341\273\215c danh s\303\241ch l\341\273\235i ch\303\272c\ncreate policy \"Allow public to read guestbook\"\non public.guestbook\nfor select\nto anon, authenticated\nusing (true);\n\n-- Policy: M\341\273\215i ng\306\260\341\273\235i \304\221\341\273\201u c\303\263 th\341\273\203 g\341\273\255i l\341\273\235i ch\303\272c m\341\273\233i\ncreate policy \"Allow public to insert guestbook\"\non public.guestbook\nfor insert\nto anon, authenticated\nwith check (true);\n\n-- Policy: Cho ph\303\251p th\341\272\243 tim / c\341\272\255p nh\341\272\255t s\341\273\221 l\306\260\341\273\243t th\303\255ch\ncreate policy \"Allow public to update guestbook likes\"\non public.guestbook\nfor update\nto anon, authenticated\nusing (true)\nwith check (true);\n\n-- 3. FUNCTION T\304\202NG L\306\257\341\273\242T TH\303\215CH CHO L\341\273\234I CH\303\232C (RPC)\ncreate or replace function increment_guestbook_like(entry_id uuid)\nreturns void as $$\nbegin\n  update public.guestbook\n  set likes_count = likes_count + 1\n  where id = entry_id;\nend;\n$$ language plpgsql security definer;\n\n-- 4. B\341\272\254T REALTIME CHO B\341\272\242NG GUESTBOOK (T\303\271y ch\341\273\215n hi\341\273\203n th\341\273\213 l\341\273\235i ch\303\272c t\341\273\251c th\303\254)\nalter publication supabase_realtime add table public.guestbook;\n\n-- 5. SEED D\341\273\256 LI\341\273\206U M\341\272\252U BAN \304\220\341\272\246U CHO S\341\273\224 L\306\257U B\303\232T\ninsert into public.guestbook (name, message, relationship, avatar_color, likes_count)\nvalues \n  (\'Nguy\341\273\205n Minh Tu\341\272\245n & Nh\303\263m b\341\272\241n \304\220\341\272\241i h\341\273\215c\', \'Ch\303\272c hai b\341\272\241n tr\304\203m n\304\203m h\341\272\241nh ph\303\272c, \304\221\341\272\247u b\341\272\241c r\304\203ng long! Ch\303\272c cho t\341\273\225 \341\272\245m nh\341\273\217 lu\303\264n tr\303\240n ng\341\272\255p ti\341\272\277ng c\306\260\341\273\235i v\303\240 y\303\252u th\306\260\306\241ng.\', \'friend\', \'rose\', 12),\n  (\'Ch\341\273\213 Th\341\272\243o & Gia \304\221\303\254nh\', \'M\341\273\253ng ng\303\240y vui c\341\273\247a hai em! Ch\303\272c hai em lu\303\264n \304\221\341\273\223ng h\303\240nh, th\341\272\245u hi\341\273\203u v\303\240 chia s\341\272\273 m\341\273\215i ni\341\273\201m vui n\341\273\227i bu\341\273\223n trong cu\341\273\231c s\341\273\221ng h\303\264n nh\303\242n.\', \'family\', \'amber\', 8),\n  (\'\304\220\341\273\251c Huy - Team C\303\264ng Ngh\341\273\207\', \'Ch\303\272c m\341\273\253ng anh Nam v\303\240 ch\341\273\213 Linh! \304\220\303\241m c\306\260\341\273\233i th\341\272\277 k\341\273\267 c\341\273\247a team m\303\254nh r\341\273\223i, ch\303\272c hai b\341\272\241n s\341\273\233m c\303\263 thi\303\252n th\341\272\247n nh\341\273\217 nh\303\251!\', \'colleague\', \'emerald\', 15),\n  (\'C\303\264 B\341\272\243y & Ch\303\272 H\303\271ng\', \'Ch\303\272c hai ch\303\241u tr\304\203m n\304\203m t\303\254nh vi\303\252n m\303\243n, b\341\272\241c \304\221\341\272\247u ngh\304\251a phu th\303\252. Gia \304\221\303\254nh hai b\303\252n lu\303\264n t\341\273\261 h\303\240o v\341\273\201 hai ch\303\241u.\', \'relative\', \'indigo\', 6)\non conflict do nothing;\n"
        path {
          absolute_uri: "file:///supabase/schema.sql"
        }
        overwrite: true
      }
    }
