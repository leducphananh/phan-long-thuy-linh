\213nh ngh\304\251a TypeScript interface (Couple, Event, RSVP, Guestbook...)\n    \342\224\234\342\224\200\342\224\200 lib/\n    \342\224\202   \342\224\234\342\224\200\342\224\200 supabase.ts         # Kh\341\273\237i t\341\272\241o Supabase client, t\303\255ch h\341\273\243p RSVP, Guestbook & Offline Fallback\n    \342\224\202   \342\224\224\342\224\200\342\224\200 calendar.ts         # Ti\341\273\207n \303\255ch t\341\272\241o li\303\252n k\341\272\277t Google Calendar & t\341\272\243i file .ICS cho Apple/Outlook\n    \342\224\234\342\224\200\342\224\200 data/\n    \342\224\202   \342\224\224\342\224\200\342\224\200 weddingData.ts      # D\341\273\257 li\341\273\207u thi\341\273\207p c\306\260\341\273\233i, timeline chuy\341\273\207n t\303\254nh y\303\252u, album \341\272\243nh & th\303\264ng tin VietQR\n    \342\224\224\342\224\200\342\224\200 components/\n        \342\224\234\342\224\200\342\224\200 Navbar.tsx          # Thanh \304\221i\341\273\201u h\306\260\341\273\233ng 3-Zone m\306\260\341\273\243t m\303\240, h\341\273\227 tr\341\273\243 menu mobile & b\341\272\255t t\341\272\257t nh\341\272\241c\n        \342\224\234\342\224\200\342\224\200 Hero.tsx            # B\303\254a thi\341\273\207p c\306\260\341\273\233i, t\303\252n d\303\242u r\341\273\203 & \304\221\341\273\223ng h\341\273\223 \304\221\341\272\277m ng\306\260\341\273\243c th\341\273\235i gian th\341\273\261c\n        \342\224\234\342\224\200\342\224\200 Story.tsx           # Timeline \"Chuy\341\273\207n ch\303\272ng m\303\254nh\" c\303\241c c\341\273\231t m\341\273\221c t\303\254nh y\303\252u\n        \342\224\234\342\224\200\342\224\200 Invitation.tsx      # L\341\273\205 th\303\240nh h\303\264n & ti\341\273\207c c\306\260\341\273\233i, nh\303\272ng Google Maps, Add to Calendar\n        \342\224\234\342\224\200\342\224\200 Gallery.tsx         # Album \341\272\243nh c\306\260\341\273\233i d\341\272\241ng Bento/Masonry k\303\250m Lightbox ph\303\263ng to c\303\263 ph\303\255m t\341\272\257t\n        \342\224\234\342\224\200\342\224\200 RSVPForm.tsx        # Form x\303\241c nh\341\272\255n tham d\341\273\261 l\306\260u v\303\240o Supabase + hi\341\273\207u \341\273\251ng ph\303\241o hoa Confetti\n        \342\224\234\342\224\200\342\224\200 Guestbook.tsx       # S\341\273\225 l\306\260u b\303\272t g\341\273\255i l\341\273\235i ch\303\272c, danh s\303\241ch cu\341\273\231n & th\341\272\243 tim th\341\273\235i gian th\341\273\261c\n        \342\224\234\342\224\200\342\224\200 GiftBox.tsx         # H\341\273\231p m\341\273\253ng h\341\272\241nh ph\303\272c t\303\255ch h\341\273\243p m\303\243 VietQR & n\303\272t sao ch\303\251p STK nhanh\n        \342\224\234\342\224\200\342\224\200 AudioPlayer.tsx     # Tr\303\254nh ph\303\241t nh\341\272\241c c\306\260\341\273\233i n\341\273\201n l\303\243ng m\341\272\241n v\341\273\233i icon \304\221\304\251a than quay\n        \342\224\234\342\224\200\342\224\200 FloatingPetals.tsx  # Hi\341\273\207u \341\273\251ng c\303\241nh hoa h\341\273\223ng r\306\241i l\303\243ng m\341\272\241n (c\303\263 n\303\272t b\341\272\255t/t\341\272\257t)\n        \342\224\234\342\224\200\342\224\200 SupabaseModal.tsx   # Modal xem m\303\243 DDL SQL, c\341\272\245u h\303\254nh API key tr\341\273\261c ti\341\272\277p v\303\240 h\306\260\341\273\233ng d\341\272\253n Deploy\n        \342\224\224\342\224\200\342\224\200 Footer.tsx          # Ch\341\273\257 k\303\275 tri \303\242n v\303\240 n\303\272t cu\341\273\231n l\303\252n \304\221\341\272\247u trang\n```\n\n---\n\n### \360\237\227\204\357\270\217 \304\220o\341\272\241n M\303\243 SQL (DDL) Tr\303\252n Supabase\n\nD\303\241n \304\221o\341\272\241n m\303\243 sau v\303\240o **Supabase Dashboard > SQL Editor** r\341\273\223i nh\341\272\245n **Run**:\n\n```sql\n-- 1. B\341\272\242NG X\303\201C NH\341\272\254N THAM GIA (RSVP)\ncreate table if not exists public.rsvp (\n    id uuid default gen_random_uuid() primary key,\n    created_at timestamp with time zone default timezone(\'utc\'::text, now()) not null,\n    name text not null,\n    phone text not null,\n    attending boolean default true not null,\n    guests_count integer default 1 not null check (guests_count >= 1 and guests_count <= 10),\n    side text default \'both\' check (side in (\'groom\', \'bride\', \'both\')),\n    message text,\n    dietary_requirements text\n);\n\n-- K\303\255ch ho\341\272\241t Row Level Security (RLS) cho b\341\272\243ng rsvp\nalter table public.rsvp enable row level security;\n\n-- Policy: Kh\303\241ch v\303\243ng lai c\303\263 th\341\273\203 g\341\273\255i form RSVP\ncreate policy \"Allow public to submit RSVP\"\non public.rsvp for insert to anon, authenticated with check (true);\n\n-- Policy: Cho ph\303\251p truy v\341\272\245n d\341\273\257 li\341\273\207u RSVP\ncreate policy \"Allow select RSVP\"\non public.rsvp for select to anon, authenticated using (true);\n\n-- 2. B\341\272\242NG S\341\273\224 L\306\257U B\303\232T & L\341\273\234I CH\303\232C (GUESTBOOK)\ncreate table if not exists public.guestbook (\n    id uuid default gen_random_uuid() primary key,\n    created_at timestamp with time zone default timezone(\'utc\'::text, now()) not null,\n    name text not null,\n    message text not null,\n    relationship text default \'friend\' check (relationship in (\'family\', \'friend\', \'colleague\', \'relative\', \'other\')),\n    avatar_color text default \'rose\',\n    likes_count integer default 0 not null check (likes_count >= 0)\n);\n\n-- K\303\255ch ho\341\272\241t Row Level Security (RLS) cho b\341\272\243ng guestbook\nalter table public.guestbook enable row level security;\n\n-- Policy: M\341\273\215i ng\306\260\341\273\235i \304\221\341\273\201u c\303\263 th\341\273\203 \304\221\341\273\215c s\341\273\225 l\306\260u b\303\272t\ncreate policy \"Allow public to read guestbook\"\non public.guestbook for select to anon, authenticated using (true);\n\n-- Policy: M\341\273\215i ng\306\260\341\273\235i \304\221\341\273\201u c\303\263 th\341\273\203 g\341\273\255i l\341\273\235i ch\303\272c m\341\273\233i\ncreate policy \"Allow public to insert guestbook\"\non public.guestbook for insert to anon, authenticated with check (true);\n\n-- Policy: Cho ph\303\251p c\341\272\255p nh\341\272\255t l\306\260\341\273\243t th\341\272\243 tim\ncreate policy \"Allow public to update guestbook likes\"\non public.guestbook for update to anon, authenticated using (true) with check (true);\n\n-- 3. FUNCTION T\304\202NG L\306\257\341\273\242T TH\303\215CH CHO L\341\273\234I CH\303\232C (RPC)\ncreate or replace function increment_guestbook_like(entry_id uuid)\nreturns void as $$\nbegin\n  update public.guestbook\n  set likes_count = likes_count + 1\n  where id = entry_id;\nend;\n$$ language plpgsql security definer;\n\n-- 4. B\341\272\254T REALTIME CHO GUESTBOOK\nalter publication supabase_realtime add table public.guestbook;\n```\n\n---\n\n### \342\234\250 C\303\241c T\303\255nh N\304\203ng N\341\273\225i B\341\272\255t\n\n1. **Hero Section & Countdown**: Hi\341\273\203n th\341\273\213 t\303\252n c\341\272\267p \304\221\303\264i (*H\341\272\243i Nam & Kh\303\241nh Linh*), ng\303\240y c\306\260\341\273\233i \303\242m/d\306\260\306\241ng l\341\273\213ch v\303\240 \304\221\341\273\223ng h\341\273\223 \304\221\341\272\277m ng\306\260\341\273\243c t\341\273\253ng gi\303\242y.\n2. **Chuy\341\273\207n ch\303\272ng m\303\254nh (Our Story)**: D\303\262ng th\341\273\235i gian t\303\254nh y\303\252u (Timeline) t\341\273\253 l\341\272\247n \304\221\341\272\247u g\341\272\267p g\341\273\241, t\341\273\217 t\303\254nh, du l\341\273\213ch \304\220\303\240 L\341\272\241t, c\341\272\247u h\303\264n Ph\303\272 Qu\341\273\221c \304\221\341\272\277n ng\303\240y c\306\260\341\273\233i.\n3. **Thi\341\273\207p M\341\273\235i & L\341\273\205 C\306\260\341\273\233i**: L\341\273\205 th\303\240nh h\303\264n v\303\240 ti\341\273\207c c\306\260\341\273\233i, nh\303\272ng Google Maps iframe, n\303\272t m\341\273\237 d\341\272\253n \304\221\306\260\341\273\235ng, \304\221\341\273\223ng b\341\273\231 s\341\273\261 ki\341\273\207n v\303\240o **Google Calendar** v\303\240 t\341\272\243i file `.ics` cho iPhone / Apple Calendar / Outlook.\n4. **Album \341\272\242nh (Gallery & Lightbox)**: L\306\260\341\273\233i \341\272\243nh \304\221a k\303\255ch th\306\260\341\273\233c ph\303\242n lo\341\272\241i theo danh m\341\273\245c (Studio, L\341\273\205 c\306\260\341\273\233i, \304\220\341\273\235i th\306\260\341\273\235ng), h\341\273\227 tr\341\273\243 xem to\303\240n m\303\240n h\303\254nh (Next/Prev, ph\303\255m m\305\251i t\303\252n v\303\240 ESC).\n5. **X\303\241c nh\341\272\255n tham d\341\273\261 (RSVP)**: Thu th\341\272\255p t\303\252n, s\341\273\221 \304\221i\341\273\207n tho\341\272\241i, tham d\341\273\261 c\303\263/kh\303\264ng, s\341\273\221 kh\303\241ch \304\221i c\303\271ng, kh\303\241ch nh\303\240 trai/g\303\241i, l\341\273\235i nh\341\272\257n. D\341\273\257 li\341\273\207u l\306\260u tr\341\273\261c ti\341\272\277p v\303\240o Supabase v\303\240 k\303\255ch ho\341\272\241t hi\341\273\207u \341\273\251ng ph\303\241o hoa ch\303\272c m\341\273\253ng.\n6. **S\341\273\225 l\306\260u b\303\272t (Guestbook)**: Kh\303\241ch vi\341\272\277t l\341\273\235i ch\303\272c, danh s\303\241ch t\341\273\261 c\341\272\255p nh\341\272\255t, t\306\260\306\241ng t\303\241c th\341\272\243 tim t\304\203ng s\341\273\221 \304\221\341\272\277m tr\341\273\261c ti\341\272\277p l\303\252n Supabase.\n7. **H\341\273\231p m\341\273\253ng c\306\260\341\273\233i & VietQR**: T\303\255ch h\341\273\243p m\303\243 VietQR cho c\341\272\243 Ch\303\272 R\341\273\203 v\303\240 C\303\264 D\303\242u c\303\271ng n\303\272t b\341\272\245m m\341\273\231t ch\341\272\241m sao ch\303\251p s\341\273\221 t\303\240i kho\341\272\243n.\n8. **Nh\341\272\241c n\341\273\201n & C\303\241nh hoa r\306\241i**: Widget \304\221\304\251a than xoay ph\303\241t nh\341\272\241c c\306\260\341\273\233i du d\306\260\306\241ng v\303\240 hi\341\273\207u \341\273\251ng hoa r\306\241i l\303\243ng m\341\272\241n nh\341\272\271 nh\303\240ng.\n9. **Ch\341\272\277 \304\221\341\273\231 Demo Fallback**: N\341\272\277u ch\306\260a \304\221i\341\273\201n kh\303\263a Supabase, website v\341\272\253n ho\341\272\241t \304\221\341\273\231ng 100% b\341\272\261ng b\341\273\231 nh\341\273\233 t\341\272\241m tr\303\254nh duy\341\273\207t; b\341\272\241n c\303\263 th\341\273\203 b\341\272\245m n\303\272t **\"Supabase SQL\"** tr\303\252n thanh ti\303\252u \304\221\341\273\201 \304\221\341\273\203 nh\341\272\255p tr\341\273\261c ti\341\272\277p URL v\303\240 Key ki\341\273\203m tra ngay l\341\272\255p t\341\273\251c."
