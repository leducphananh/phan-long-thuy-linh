    content: "/**\n * Wedding Invitation Types & Data Models\n */\n\nexport interface WeddingCouple {\n  groom: {\n    name: string;\n    fullName: string;\n    title: string;\n    fatherName: string;\n    motherName: string;\n    address: string;\n    phone: string;\n    bankInfo?: {\n      bankName: string;\n      accountNumber: string;\n      accountName: string;\n      qrCodeUrl: string;\n    };\n  };\n  bride: {\n    name: string;\n    fullName: string;\n    title: string;\n    fatherName: string;\n    motherName: string;\n    address: string;\n    phone: string;\n    bankInfo?: {\n      bankName: string;\n      accountNumber: string;\n      accountName: string;\n      qrCodeUrl: string;\n    };\n  };\n  weddingDate: string; // ISO date string, e.g. \"2026-11-28T18:00:00+07:00\"\n  lunarDate: string;   // e.g. \"Ng\303\240y 19 th\303\241ng 10 n\304\203m B\303\255nh Ng\341\273\215\"\n}\n\nexport interface StoryMilestone {\n  id: string;\n  year: string;\n  date: string;\n  title: string;\n  description: string;\n  imageUrl: string;\n  imageAlt: string;\n  location?: string;\n}\n\nexport interface WeddingEvent {\n  id: string;\n  type: \'ceremony\' | \'reception\' | \'engagement\';\n  title: string;\n  subtitle: string;\n  date: string;\n  time: string;\n  lunarTime: string;\n  venueName: string;\n  address: string;\n  mapEmbedUrl: string;\n  mapDirectUrl: string;\n  calendarEvent: {\n    title: string;\n    details: string;\n    location: string;\n    startTime: string; // YYYYMMDDTHHmmssZ\n    endTime: string;\n  };\n}\n\nexport interface GalleryPhoto {\n  id: string;\n  title: string;\n  subtitle?: string;\n  category: \'all\' | \'prewedding\' | \'ceremony\' | \'casual\';\n  thumbnailUrl: string;\n  fullUrl: string;\n  aspectRatio: \'square\' | \'portrait\' | \'landscape\';\n}\n\nexport interface RSVPFormData {\n  name: string;\n  phone: string;\n  attending: boolean;\n  guestsCount: number;\n  side: \'groom\' | \'bride\' | \'both\';\n  message?: string;\n  dietaryRequirements?: string;\n}\n\nexport interface GuestbookEntry {\n  id: string;\n  created_at: string;\n  name: string;\n  message: string;\n  relationship?: string;\n  avatar_color?: string;\n  likes_count?: number;\n}\n"
    raw_content: "/**\n * Wedding Invitation Types & Data Models\n */\n\nexport interface WeddingCouple {\n  groom: {\n    name: string;\n    fullName: string;\n    title: string;\n    fatherName: string;\n    motherName: string;\n    address: string;\n    phone: string;\n    bankInfo?: {\n      bankName: string;\n      accountNumber: string;\n      accountName: string;\n      qrCodeUrl: string;\n    };\n  };\n  bride: {\n    name: string;\n    fullName: string;\n    title: string;\n    fatherName: string;\n    motherName: string;\n    address: string;\n    phone: string;\n    bankInfo?: {\n      bankName: string;\n      accountNumber: string;\n      accountName: string;\n      qrCodeUrl: string;\n    };\n  };\n  weddingDate: string; // ISO date string, e.g. \"2026-11-28T18:00:00+07:00\"\n  lunarDate: string;   // e.g. \"Ng\303\240y 19 th\303\241ng 10 n\304\203m B\303\255nh Ng\341\273\215\"\n}\n\nexport interface StoryMilestone {\n  id: string;\n  year: string;\n  date: string;\n  title: string;\n  description: string;\n  imageUrl: string;\n  imageAlt: string;\n  location?: string;\n}\n\nexport interface WeddingEvent {\n  id: string;\n  type: \'ceremony\' | \'reception\' | \'engagement\';\n  title: string;\n  subtitle: string;\n  date: string;\n  time: string;\n  lunarTime: string;\n  venueName: string;\n  address: string;\n  mapEmbedUrl: string;\n  mapDirectUrl: string;\n  calendarEvent: {\n    title: string;\n    details: string;\n    location: string;\n    startTime: string; // YYYYMMDDTHHmmssZ\n    endTime: string;\n  };\n}\n\nexport interface GalleryPhoto {\n  id: string;\n  title: string;\n  subtitle?: string;\n  category: \'all\' | \'prewedding\' | \'ceremony\' | \'casual\';\n  thumbnailUrl: string;\n  fullUrl: string;\n  aspectRatio: \'square\' | \'portrait\' | \'landscape\';\n}\n\nexport interface RSVPFormData {\n  name: string;\n  phone: string;\n  attending: boolean;\n  guestsCount: number;\n  side: \'groom\' | \'bride\' | \'both\';\n  message?: string;\n  dietaryRequirements?: string;\n}\n\nexport interface GuestbookEntry {\n  id: string;\n  created_at: string;\n  name: string;\n  message: string;\n  relationship?: string;\n  avatar_color?: string;\n  likes_count?: number;\n}\n"
    num_lines: 101
