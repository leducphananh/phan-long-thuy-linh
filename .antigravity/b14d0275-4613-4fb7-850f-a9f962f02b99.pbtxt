      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Calendar, Clock, MapPin, ExternalLink, Download, Compass, Check, Heart } from \'lucide-react\';\\nimport { WeddingCouple, WeddingEvent } from \'../types/wedding\';\\nimport { getGoogleCalendarUrl, downloadIcsFile } from \'../lib/calendar\';\\nimport { ScrollReveal } from \'./ScrollReveal\';\\n\\ninterface InvitationProps {\\n  couple: WeddingCouple;\\n  events: WeddingEvent[];\\n}\\n\\nexport const Invitation: React.FC<InvitationProps> = ({ couple, events }) => {\\n  const [activeEventTab, setActiveEventTab] = useState<string>(events[1]?.id || events[0]?.id);\\n  const [downloadSuccessId, setDownloadSuccessId] = useState<string | null>(null);\\n\\n  const selectedEvent = events.find((e) => e.id === activeEventTab) || events[0];\\n\\n  const handleDownloadIcs = (event: WeddingEvent) => {\\n    downloadIcsFile(event);\\n    setDownloadSuccessId(event.id);\\n    setTimeout(() => setDownloadSuccessId(null), 3000);\\n  };\\n\\n  return (\\n    <section id=\\\"invitation\\\" className=\\\"relative py-24 sm:py-32 px-4 sm:px-6 overflow-hidden\\\">\\n      {/* Scenic Wedding Hall / Venue Background Image */}\\n      <div className=\\\"absolute inset-0 z-0 pointer-events-none\\\">\\n        <img\\n          src=\\\"https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=2000&q=80\\\"\\n          alt=\\\"Wedding venue backdrop\\\"\\n          referrerPolicy=\\\"no-referrer\\\"\\n          className=\\\"w-full h-full object-cover object-center filter blur-[3px] opacity-20 transform scale-105\\\"\\n        />\\n        <div className=\\\"absolute inset-0 bg-gradient-to-b from-[#FAF8F5] via-[#FAF8F5]/85 to-[#FAF8F5]\\\" />\\n      </div>\\n\\n      <div className=\\\"relative z-10 max-w-5xl mx-auto\\\">\\n        {/* Section Header with ScrollReveal */}\\n        <ScrollReveal animation=\\\"fade-up\\\" duration={700}>\\n          <div className=\\\"text-center mb-16\\\">\\n            <p className=\\\"font-script text-2xl sm:text-3xl text-rose-600 mb-1\\\">\\n              Wedding Invitation\\n            </p>\\n            <h2 className=\\\"font-serif text-3xl sm:text-5xl font-bold text-stone-900 tracking-tight text-balance\\\">\\n              Thi\341\273\207p M\341\273\235i B\303\241o H\341\273\211\\n            </h2>\\n            <div className=\\\"mt-4 flex items-center justify-center gap-3\\\">\\n              <div className=\\\"h-px w-12 bg-rose-300\\\" />\\n              <Heart className=\\\"w-4 h-4 fill-rose-500 text-rose-500\\\" />\\n              <div className=\\\"h-px w-12 bg-rose-300\\\" />\\n            </div>\\n            <p className=\\\"mt-3 font-serif italic text-stone-600 text-sm sm:text-base\\\">\\n              K\303\255nh m\341\273\235i Qu\303\275 kh\303\241ch t\341\273\233i chung vui c\303\271ng gia \304\221\303\254nh ch\303\272ng t\303\264i\\n            </p>\\n          </div>\\n        </ScrollReveal>\\n\\n        {/* Traditional Invitation Card Frame */}\\n        <ScrollReveal animation=\\\"zoom-in\\\" delay={150} duration={750}>\\n          <div className=\\\"bg-white/95 backdrop-blur-md rounded-3xl p-6 sm:p-10 lg:p-12 shadow-xl border border-stone-200/90 mb-12 relative overflow-hidden\\\">\\n            {/* Subtle vintage corner ornamentation */}\\n            <div className=\\\"absolute top-0 left-0 w-16 h-16 border-t-2 border-l-2 border-rose-300/60 rounded-tl-3xl m-3 pointer-events-none\\\" />\\n            <div className=\\\"absolute bottom-0 right-0 w-16 h-16 border-b-2 border-r-2 border-rose-300/60 rounded-br-3xl m-3 pointer-events-none\\\" />\\n\\n            {/* Family Introduction (Nh\303\240 Trai & Nh\303\240 G\303\241i) */}\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-8 pb-10 border-b border-stone-200 text-center\\\">\\n              {/* Nh\303\240 Trai */}\\n              <div className=\\\"p-5 rounded-2xl bg-stone-50/80 border border-stone-100 hover:shadow-xs transition-shadow\\\">\\n                <span className=\\\"text-xs uppercase tracking-widest text-rose-700 font-semibold block mb-2\\\">\\n                  NH\303\200 TRAI\\n                </span>\\n                <p className=\\\"text-sm text-stone-700 font-medium\\\">\\n                  \303\224ng: <strong className=\\\"text-stone-900\\\">{couple.groom.fatherName}</strong>\\n                </p>\\n                <p className=\\\"text-sm text-stone-700 font-medium mt-0.5\\\">\\n                  B\303\240: <strong className=\\\"text-stone-900\\\">{couple.groom.motherName}</strong>\\n                </p>\\n                <p className=\\\"text-xs text-stone-500 mt-2\\\">\\n                  {couple.groom.address}\\n                </p>\\n\\n                <div className=\\\"mt-5 pt-3 border-t border-stone-200/70\\\">\\n                  <span className=\\\"text-xs text-stone-500 block uppercase tracking-wider\\\">Ch\303\272 R\341\273\203</span>\\n                  <p className=\\\"font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1\\\">\\n                    {couple.groom.fullName}\\n                  </p>\\n                </div>\\n              </div>\\n\\n              {/* Nh\303\240 G\303\241i */}\\n              <div className=\\\"p-5 rounded-2xl bg-stone-50/80 border border-stone-100 hover:shadow-xs transition-shadow\\\">\\n                <span className=\\\"text-xs uppercase tracking-widest text-rose-700 font-semibold block mb-2\\\">\\n                  NH\303\200 G\303\201I\\n                </span>\\n                <p className=\\\"text-sm text-stone-700 font-medium\\\">\\n                  \303\224ng: <strong className=\\\"text-stone-900\\\">{couple.bride.fatherName}</strong>\\n                </p>\\n                <p className=\\\"text-sm text-stone-700 font-medium mt-0.5\\\">\\n                  B\303\240: <strong className=\\\"text-stone-900\\\">{couple.bride.motherName}</strong>\\n                </p>\\n                <p className=\\\"text-xs text-stone-500 mt-2\\\">\\n                  {couple.bride.address}\\n                </p>\\n\\n                <div className=\\\"mt-5 pt-3 border-t border-stone-200/70\\\">\\n                  <span className=\\\"text-xs text-stone-500 block uppercase tracking-wider\\\">C\303\264 D\303\242u</span>\\n                  <p className=\\\"font-serif text-2xl sm:text-3xl font-bold text-stone-900 mt-1\\\">\\n                    {couple.bride.fullName}\\n                  </p>\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Invitation Letter Prose */}\\n            <div className=\\\"py-8 text-center max-w-2xl mx-auto\\\">\\n              <p className=\\\"font-cormorant text-lg sm:text-xl text-stone-700 italic leading-relaxed\\\">\\n                &ldquo;S\341\273\261 hi\341\273\207n di\341\273\207n c\341\273\247a Qu\303\275 kh\303\241ch l\303\240 ni\341\273\201m vinh h\341\272\241nh v\303\240 l\341\273\235i ch\303\272c ph\303\272c qu\303\275 gi\303\241 nh\341\272\245t d\303\240nh cho \304\221\303\264i uy\303\252n \306\260\306\241ng v\303\240 gia \304\221\303\254nh ch\303\272ng t\303\264i trong ng\303\240y vui tr\341\273\215ng \304\221\341\272\241i.&rdquo;\\n              </p>\\n            </div>\\n\\n            {/* Event Selector Segmented Control */}\\n            <div className=\\\"flex items-center justify-center gap-2 p-1.5 bg-stone-100 rounded-2xl max-w-md mx-auto mb-8\\\">\\n              {events.map((event) => (\\n                <button\\n                  key={event.id}\\n                  onClick={() => setActiveEventTab(event.id)}\\n                  className={`flex-1 py-2 px-3 text-xs sm:text-sm font-semibold rounded-xl transition-all whitespace-nowrap ${\\n                    activeEventTab === event.id\\n                      ? \'bg-white text-stone-900 shadow-xs\'\\n                      : \'text-stone-600 hover:text-stone-900\'\\n                  }`}\\n                >\\n                  {event.title}\\n                </button>\\n              ))}\\n            </div>\\n\\n            {/* Active Event Details */}\\n            {selectedEvent && (\\n              <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\\\">\\n                {/* Event Info (Left Column) */}\\n                <div className=\\\"lg:col-span-6 space-y-6\\\">\\n                  <div>\\n                    <span className=\\\"text-xs text-rose-600 font-semibold uppercase tracking-wider block mb-1\\\">\\n                      {selectedEvent.subtitle}\\n                    </span>\\n                    <h3 className=\\\"font-serif text-2xl sm:text-3xl font-bold text-stone-900\\\">\\n                      {selectedEvent.venueName}\\n                    </h3>\\n                  </div>\\n\\n                  <div className=\\\"space-y-3 text-sm text-stone-700\\\">\\n                    <div className=\\\"flex items-start gap-3 p-3.5 rounded-2xl bg-stone-50 border border-stone-100\\\">\\n                      <Clock className=\\\"w-5 h-5 text-rose-600 shrink-0 mt-0.5\\\" />\\n                      <div>\\n                        <strong className=\\\"block text-stone-900 font-semibold\\\">{selectedEvent.time}</strong>\\n                        <span className=\\\"text-xs text-stone-500\\\">{selectedEvent.lunarTime}</span>\\n                      </div>\\n                    </div>\\n\\n                    <div className=\\\"flex items-start gap-3 p-3.5 rounded-2xl bg-stone-50 border border-stone-100\\\">\\n                      <Calendar className=\\\"w-5 h-5 text-rose-600 shrink-0 mt-0.5\\\" />\\n                      <div>\\n                        <strong className=\\\"block text-stone-900 font-semibold\\\">{selectedEvent.date}</strong>\\n                        <span className=\\\"text-xs text-stone-500\\\">K\303\255nh m\341\273\235i Qu\303\275 kh\303\241ch \304\221\341\272\277n tham d\341\273\261 \304\221\303\272ng gi\341\273\235</span>\\n                      </div>\\n                    </div>\\n\\n                    <div className=\\\"flex items-start gap-3 p-3.5 rounded-2xl bg-stone-50 border border-stone-100\\\">\\n                      <MapPin className=\\\"w-5 h-5 text-rose-600 shrink-0 mt-0.5\\\" />\\n                      <div>\\n                        <strong className=\\\"block text-stone-900 font-semibold\\\">\304\220\341\273\213a \304\220i\341\273\203m:</strong>\\n                        <span className=\\\"text-xs sm:text-sm text-stone-600\\\">{selectedEvent.address}</span>\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  {/* Calendar & Map Action Buttons */}\\n                  <div className=\\\"space-y-2 pt-2\\\">\\n                    <span className=\\\"text-xs font-semibold text-stone-500 uppercase tracking-wider block\\\">\\n                      L\306\260u l\341\273\213ch &amp; Ch\341\273\211 \304\221\306\260\341\273\235ng:\\n                    </span>\\n                    <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                      <a\\n                        href={getGoogleCalendarUrl(selectedEvent)}\\n                        target=\\\"_blank\\\"\\n                        rel=\\\"noopener noreferrer\\\"\\n                        className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs sm:text-sm font-semibold bg-rose-600 text-white rounded-xl hover:bg-rose-700 transition-colors shadow-xs\\\"\\n                      >\\n                        <Calendar className=\\\"w-4 h-4\\\" />\\n                        Google Calendar\\n                        <ExternalLink className=\\\"w-3 h-3 ml-0.5 opacity-80\\\" />\\n                      </a>\\n\\n                      <button\\n                        onClick={() => handleDownloadIcs(selectedEvent)}\\n                        className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs sm:text-sm font-medium border border-stone-300 text-stone-700 bg-white rounded-xl hover:bg-stone-50 transition-colors shadow-xs\\\"\\n                      >\\n                        {downloadSuccessId === selectedEvent.id ? (\\n                          <>\\n                            <Check className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                            <span className=\\\"text-emerald-700\\\">\304\220\303\243 t\341\272\243i file .ICS</span>\\n                          </>\\n                        ) : (\\n                          <>\\n                            <Download className=\\\"w-4 h-4 text-stone-500\\\" />\\n                            <span>T\341\272\243i file .ICS</span>\\n                          </>\\n                        )}\\n                      </button>\\n\\n                      <a\\n                        href={selectedEvent.mapDirectUrl}\\n                        target=\\\"_blank\\\"\\n                        rel=\\\"noopener noreferrer\\\"\\n                        className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs sm:text-sm font-medium border border-stone-300 text-stone-700 bg-white rounded-xl hover:bg-stone-50 transition-colors shadow-xs\\\"\\n                      >\\n                        <Compass className=\\\"w-4 h-4 text-rose-600\\\" />\\n                        M\341\273\237 Google Maps\\n                      </a>\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                {/* Embedded Google Map (Right Column) */}\\n                <div className=\\\"lg:col-span-6 w-full h-[320px] sm:h-[390px] rounded-2xl overflow-hidden border border-stone-200/90 shadow-inner bg-stone-100 relative\\\">\\n                  <iframe\\n                    title={`B\341\272\243n \304\221\341\273\223 ${selectedEvent.venueName}`}\\n                    src={selectedEvent.mapEmbedUrl}\\n                    width=\\\"100%\\\"\\n                    height=\\\"100%\\\"\\n                    style={{ border: 0 }}\\n                    allowFullScreen={false}\\n                    loading=\\\"lazy\\\"\\n                    referrerPolicy=\\\"no-referrer-when-downgrade\\\"\\n                    className=\\\"w-full h-full\\\"\\n                  />\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        </ScrollReveal>\\n      </div>\\n    </section>\\n  );\\n};\\n\",\"Description\":\"Add scenic background image and ScrollReveal entrance effects to Invitation component\",\"Overwrite\":true,\"TargetFile\":\"/src/components/Invitation.tsx\",\"toolAction\":\"Updating Invitation component\",\"toolSummary\":\"Add background image and scroll animations to Invitation.tsx\"}"
      thought_signature: ""
      original_name: "write_to_file"
    }
