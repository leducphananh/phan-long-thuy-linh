sparent py-4 text-white\'\\n      }`}\\n    >\\n      <div className=\\\"max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between\\\">\\n        {/* Zone 1: Single text element wordmark */}\\n        <a\\n          href=\\\"#hero\\\"\\n          onClick={(e) => handleLinkClick(e, \'#hero\')}\\n          className={`font-serif text-lg sm:text-xl font-bold tracking-wider flex items-center gap-1.5 transition-colors ${\\n            isScrolled ? \'text-stone-900 hover:text-rose-700\' : \'text-white hover:text-rose-200\'\\n          }`}\\n        >\\n          <span>Nam</span>\\n          <Heart className=\\\"w-3.5 h-3.5 fill-rose-500 text-rose-500 inline-block animate-pulse\\\" />\\n          <span>Linh</span>\\n        </a>\\n\\n        {/* Zone 2: 4-6 clean text navigation links */}\\n        <nav className=\\\"hidden md:flex items-center gap-6 lg:gap-8\\\">\\n          {navLinks.map((link) => (\\n            <a\\n              key={link.href}\\n              href={link.href}\\n              onClick={(e) => handleLinkClick(e, link.href)}\\n              className={`text-sm tracking-wide transition-colors relative py-1 hover:text-rose-600 ${\\n                isScrolled ? \'text-stone-600 font-medium\' : \'text-stone-100/90 font-medium drop-shadow-xs\'\\n              }`}\\n            >\\n              {link.label}\\n            </a>\\n          ))}\\n        </nav>\\n\\n        {/* Zone 3: 1-2 primary actions */}\\n        <div className=\\\"flex items-center gap-2 sm:gap-3\\\">\\n          {/* Music Quick Toggle */}\\n          <button\\n            onClick={onToggleMusic}\\n            aria-label=\\\"B\341\272\255t/T\341\272\257t nh\341\272\241c n\341\273\201n\\\"\\n            className={`p-2 rounded-full transition-colors flex items-center justify-center ${\\n              isScrolled\\n                ? \'bg-stone-100 text-stone-700 hover:bg-stone-200\'\\n                : \'bg-white/20 text-white backdrop-blur-xs hover:bg-white/30\'\\n            }`}\\n            title={isPlayingMusic ? \'T\341\272\241m d\341\273\253ng nh\341\272\241c n\341\273\201n\' : \'Ph\303\241t nh\341\272\241c n\341\273\201n\'}\\n          >\\n            {isPlayingMusic ? <Volume2 className=\\\"w-4 h-4 text-rose-600 animate-pulse\\\" /> : <VolumeX className=\\\"w-4 h-4\\\" />}\\n          </button>\\n\\n          {/* Database Setup Modal Trigger */}\\n          <button\\n            onClick={onOpenSupabaseModal}\\n            className={`px-3 py-1.5 text-xs font-medium rounded-lg flex items-center gap-1.5 transition-colors whitespace-nowrap ${\\n              isScrolled\\n                ? \'border border-stone-200 text-stone-700 hover:bg-stone-50\'\\n                : \'border border-white/30 text-white hover:bg-white/10 backdrop-blur-xs\'\\n            }`}\\n            title=\\\"C\341\272\245u h\303\254nh k\341\272\277t n\341\273\221i Supabase\\\"\\n          >\\n            <Database className=\\\"w-3.5 h-3.5 text-emerald-500\\\" />\\n            <span className=\\\"hidden sm:inline\\\">\\n              {supabaseConfig.isConfigured ? \'Supabase Live\' : \'Supabase SQL\'}\\n            </span>\\n          </button>\\n\\n          {/* Primary Action Button */}\\n          <a\\n            href=\\\"#rsvp\\\"\\n            onClick={(e) => handleLinkClick(e, \'#rsvp\')}\\n            className=\\\"px-3.5 py-1.5 text-xs sm:text-sm font-medium text-white bg-rose-600 rounded-lg hover:bg-rose-700 transition-colors shadow-xs whitespace-nowrap active:scale-95\\\"\\n          >\\n            X\303\241c Nh\341\272\255n Tham D\341\273\261\\n          </a>\\n\\n          {/* Mobile hamburger button */}\\n          <button\\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\\n            className={`md:hidden p-2 rounded-lg transition-colors ${\\n              isScrolled ? \'text-stone-800 hover:bg-stone-100\' : \'text-white hover:bg-white/10\'\\n            }`}\\n            aria-label=\\\"M\341\273\237 menu\\\"\\n          >\\n            {mobileMenuOpen ? <X className=\\\"w-5 h-5\\\" /> : <Menu className=\\\"w-5 h-5\\\" />}\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Mobile dropdown drawer */}\\n      {mobileMenuOpen && (\\n        <div className=\\\"md:hidden bg-white/95 backdrop-blur-lg border-b border-stone-200 px-4 pt-3 pb-6 shadow-xl animate-in slide-in-from-top duration-200\\\">\\n          <div className=\\\"flex flex-col gap-3\\\">\\n            {navLinks.map((link) => (\\n              <a\\n                key={link.href}\\n                href={link.href}\\n                onClick={(e) => handleLinkClick(e, link.href)}\\n                className=\\\"text-stone-700 hover:text-rose-600 font-medium py-2 px-3 rounded-md hover:bg-stone-50 transition-colors text-base\\\"\\n              >\\n                {link.label}\\n              </a>\\n            ))}\\n            <div className=\\\"pt-2 border-t border-stone-100 flex items-center justify-between gap-3\\\">\\n              <button\\n                onClick={() => {\\n                  setMobileMenuOpen(false);\\n                  onOpenSupabaseModal();\\n                }}\\n                className=\\\"flex-1 py-2 px-3 text-xs font-medium border border-stone-200 text-stone-700 rounded-md hover:bg-stone-50 flex items-center justify-center gap-1.5\\\"\\n              >\\n                <Database className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                C\341\272\245u h\303\254nh Supabase\\n              </button>\\n              <button\\n                onClick={onToggleMusic}\\n                className=\\\"py-2 px-4 text-xs font-medium bg-rose-50 text-rose-700 rounded-md hover:bg-rose-100 flex items-center gap-1.5\\\"\\n              >\\n                <Music className=\\\"w-3.5 h-3.5\\\" />\\n                {isPlayingMusic ? \'T\341\272\257t nh\341\272\241c\' : \'B\341\272\255t nh\341\272\241c\'}\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </header>\\n  );\\n};\\n\",\"Description\":\"Create Navbar component following 3-zone Top Bar Contract and responsive mobile menu\",\"Overwrite\":true,\"TargetFile\":\"/src/components/Navbar.tsx\",\"toolAction\":\"Creating Navbar component\",\"toolSummary\":\"Create src/components/Navbar.tsx\"}"
