    end_line: 75
    content: "import React, { useState } from \'react\';\nimport { Sparkles, EyeOff, Eye } from \'lucide-react\';\n\nexport const FloatingPetals: React.FC = () => {\n  const [enabled, setEnabled] = useState(true);\n\n  if (!enabled) {\n    return (\n      <div className=\"fixed bottom-5 left-5 z-40\">\n        <button\n          onClick={() => setEnabled(true)}\n          className=\"p-2 bg-white/80 backdrop-blur-xs rounded-full border border-stone-200 text-stone-600 hover:text-rose-600 shadow-md transition-all text-xs flex items-center gap-1.5\"\n          title=\"B\341\272\255t hi\341\273\207u \341\273\251ng c\303\241nh hoa r\306\241i\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5 text-rose-500\" />\n          <span className=\"hidden sm:inline text-[11px] font-medium\">B\341\272\255t hoa r\306\241i</span>\n        </button>\n      </div>\n    );\n  }\n\n  // 12 subtle floating petals with varying offsets, durations, and sizes\n  const petals = Array.from({ length: 12 }).map((_, i) => ({\n    id: i,\n    left: `${(i * 8.5 + 4) % 96}%`,\n    animationDelay: `${(i * 1.3) % 8}s`,\n    animationDuration: `${10 + (i % 5) * 2}s`,\n    size: 14 + (i % 4) * 4,\n    opacity: 0.35 + (i % 3) * 0.15,\n  }));\n\n  return (\n    <>\n      <div className=\"fixed inset-0 pointer-events-none z-30 overflow-hidden\">\n        {petals.map((p) => (\n          <div\n            key={p.id}\n            className=\"absolute top-[-40px] animate-petal select-none\"\n            style={{\n              left: p.left,\n              animationDelay: p.animationDelay,\n              animationDuration: p.animationDuration,\n              opacity: p.opacity,\n            }}\n          >\n            {/* SVG Rose Petal */}\n            <svg\n              width={p.size}\n              height={p.size}\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n              <path\n                d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"\n                fill=\"#fda4af\"\n              />\n            </svg>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"fixed bottom-5 left-5 z-40\">\n        <button\n          onClick={() => setEnabled(false)}\n          className=\"p-2 bg-white/80 backdrop-blur-xs rounded-full border border-stone-200 text-stone-500 hover:text-stone-800 shadow-md transition-all text-xs flex items-center gap-1.5\"\n          title=\"T\341\272\257t hi\341\273\207u \341\273\251ng c\303\241nh hoa r\306\241i\"\n        >\n          <EyeOff className=\"w-3.5 h-3.5\" />\n          <span className=\"hidden sm:inline text-[11px] font-medium\">T\341\272\257t hoa r\306\241i</span>\n        </button>\n      </div>\n    </>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport { Sparkles, EyeOff, Eye } from \'lucide-react\';\n\nexport const FloatingPetals: React.FC = () => {\n  const [enabled, setEnabled] = useState(true);\n\n  if (!enabled) {\n    return (\n      <div className=\"fixed bottom-5 left-5 z-40\">\n        <button\n          onClick={() => setEnabled(true)}\n          className=\"p-2 bg-white/80 backdrop-blur-xs rounded-full border border-stone-200 text-stone-600 hover:text-rose-600 shadow-md transition-all text-xs flex items-center gap-1.5\"\n          title=\"B\341\272\255t hi\341\273\207u \341\273\251ng c\303\241nh hoa r\306\241i\"\n        >\n          <Sparkles className=\"w-3.5 h-3.5 text-rose-500\" />\n          <span className=\"hidden sm:inline text-[11px] font-medium\">B\341\272\255t hoa r\306\241i</span>\n        </button>\n      </div>\n    );\n  }\n\n  // 12 subtle floating petals with varying offsets, durations, and sizes\n  const petals = Array.from({ length: 12 }).map((_, i) => ({\n    id: i,\n    left: `${(i * 8.5 + 4) % 96}%`,\n    animationDelay: `${(i * 1.3) % 8}s`,\n    animationDuration: `${10 + (i % 5) * 2}s`,\n    size: 14 + (i % 4) * 4,\n    opacity: 0.35 + (i % 3) * 0.15,\n  }));\n\n  return (\n    <>\n      <div className=\"fixed inset-0 pointer-events-none z-30 overflow-hidden\">\n        {petals.map((p) => (\n          <div\n            key={p.id}\n            className=\"absolute top-[-40px] animate-petal select-none\"\n            style={{\n              left: p.left,\n              animationDelay: p.animationDelay,\n              animationDuration: p.animationDuration,\n              opacity: p.opacity,\n            }}\n          >\n            {/* SVG Rose Petal */}\n            <svg\n              width={p.size}\n              height={p.size}\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n              <path\n                d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"\n                fill=\"#fda4af\"\n              />\n            </svg>\n          </div>\n        ))}\n      </div>\n\n      <div className=\"fixed bottom-5 left-5 z-40\">\n        <button\n          onClick={() => setEnabled(false)}\n          className=\"p-2 bg-white/80 backdrop-blur-xs rounded-full border border-stone-200 text-stone-500 hover:text-stone-800 shadow-md transition-all text-xs flex items-center gap-1.5\"\n          title=\"T\341\272\257t hi\341\273\207u \341\273\251ng c\303\241nh hoa r\306\241i\"\n        >\n          <EyeOff className=\"w-3.5 h-3.5\" />\n          <span className=\"hidden sm:inline text-[11px] font-medium\">T\341\272\257t hoa r\306\241i</span>\n        </button>\n      </div>\n    </>\n  );\n};\n"
    num_lines: 76
    num_bytes: 2668
  }
