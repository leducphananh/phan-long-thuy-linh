  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { Heart, Send, MessageCircle, Clock, Sparkles, User, Database, Smile } from \'lucide-react\';\nimport { GuestbookEntry } from \'../types/wedding\';\nimport { fetchGuestbook, submitGuestbookWish, likeGuestbookWish } from \'../lib/supabase\';\nimport { ScrollReveal } from \'./ScrollReveal\';\n\nexport const Guestbook: React.FC = () => {\n  const [wishes, setWishes] = useState<GuestbookEntry[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [submitting, setSubmitting] = useState(false);\n  const [name, setName] = useState(\'\');\n  const [message, setMessage] = useState(\'\');\n  const [relationship, setRelationship] = useState(\'friend\');\n  const [likedMap, setLikedMap] = useState<Record<string, boolean>>({});\n  const [storageMode, setStorageMode] = useState<\'supabase\' | \'local\'>(\'local\');\n\n  useEffect(() => {\n    loadWishes();\n  }, []);\n\n  const loadWishes = async () => {\n    setLoading(true);\n    try {\n      const res = await fetchGuestbook();\n      setWishes(res.data);\n      setStorageMode(res.mode);\n    } catch (err) {\n      console.error(\'Failed to load guestbook:\', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSendWish = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim() || !message.trim()) return;\n\n    setSubmitting(true);\n    try {\n      const avatarColors = [\'rose\', \'amber\', \'emerald\', \'indigo\', \'violet\'];\n      const randomColor = avatarColors[Math.floor(Math.random() * avatarColors.length)];\n\n      const res = await submitGuestbookWish(name, message, relationship, randomColor);\n      if (res.success) {\n        setWishes((prev) => [res.entry, ...prev]);\n        setName(\'\');\n        setMessage(\'\');\n        setStorageMode(res.mode);\n      }\n    } catch (err) {\n      console.error(\'Failed to submit wish:\', err);\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  const handleLike = async (id: string) => {\n    if (likedMap[id]) return;\n\n    setLikedMap((prev) => ({ ...prev, [id]: true }));\n    setWishes((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, likes_count: (item.likes_count || 0) + 1 } : item))\n    );\n\n    await likeGuestbookWish(id);\n  };\n\n  const formatRelativeTime = (isoString: string) => {\n    try {\n      const date = new Date(isoString);\n      const now = new Date();\n      const diffMs = now.getTime() - date.getTime();\n      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));\n      const diffDays = Math.floor(diffHours / 24);\n\n      if (diffHours < 1) return \'V\341\273\253a xong\';\n      if (diffHours < 24) return `${diffHours} gi\341\273\235 tr\306\260\341\273\233c`;\n      if (diffDays === 1) return \'H\303\264m qua\';\n      return `${diffDays} ng\303\240y tr\306\260\341\273\233c`;\n    } catch {\n      return \'G\341\272\247n \304\221\303\242y\';\n    }\n  };\n\n  const getRelationshipLabel = (rel?: string) => {\n    switch (rel) {\n      case \'family\':\n        return \'Gia \304\221\303\254nh\';\n      case \'friend\':\n        return \'B\341\272\241n b\303\250\';\n      case \'colleague\':\n        return \'\304\220\341\273\223ng nghi\341\273\207p\';\n      case \'relative\':\n        return \'H\341\273\215 h\303\240ng\';\n      default:\n        return \'B\341\272\241n b\303\250\';\n    }\n  };\n\n  return (\n    <section id=\"guestbook\" className=\"relative py-24 sm:py-32 px-4 sm:px-6 overflow-hidden\">\n      {/* Scenic Bright Joyful Wedding Celebration Backdrop */}\n      <div className=\"absolute inset-0 z-0 pointer-events-none\">\n        <img\n          src=\"https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=2000&q=80\"\n          alt=\"Bright celebratory party background\"\n          referrerPolicy=\"no-referrer\"\n          className=\"w-full h-full object-cover object-center filter blur-[2px] opacity-20 transform scale-105\"\n        />\n        <div className=\"absolute inset-0 bg-gradient-to-b from-[#FFFDFB]/90 via-[#FFFDFB]/75 to-[#FFFDFB]/90\" />\n      </div>\n\n      <div className=\"relative z-10 max-w-5xl mx-auto\">\n        {/* Section Header */}\n        <ScrollReveal animation=\"fade-up\" duration={700}>\n          <div className=\"text-center mb-12 sm:mb-16\">\n            <p className=\"font-script text-3xl sm:text-4xl text-rose-500 mb-1\">\n              Guestbook\n            </p>\n            <h2 className=\"font-serif text-3xl sm:text-5xl font-bold text-stone-900 tracking-tight text-balance\">\n              S\341\273\225 L\306\260u B\303\272t &amp; L\341\273\235i Ch\303\272c\n            </h2>\n            <div className=\"mt-4 flex items-center justify-center gap-3\">\n              <div className=\"h-px w-12 bg-rose-300\" />\n              <Heart className=\"w-4 h-4 fill-rose-500 text-rose-500\" />\n              <div className=\"h-px w-12 bg-rose-300\" />\n            </div>\n            <p className=\"mt-4 text-sm sm:text-base text-stone-600 max-w-lg mx-auto font-medium\">\n              M\341\273\227i l\341\273\235i ch\303\272c ph\303\272c \341\272\245m \303\241p t\341\273\253 b\341\272\241n l\303\240 m\341\273\231t m\303\263n qu\303\240 v\303\264 gi\303\241 \304\221\341\273\223ng h\303\240nh c\303\271ng \304\221\303\264i v\341\273\243 ch\341\273\223ng son tr\303\252n ch\341\272\267ng \304\221\306\260\341\273\235ng m\341\273\233i.\n            </p>\n          </div>\n        </ScrollReveal>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          {/* Left Column: Form to Submit Wish */}\n          <div className=\"lg:col-span-5\">\n            <ScrollReveal animation=\"fade-right\" delay={150} duration={700}>\n              <div className=\"bg-white/98 backdrop-blur-md p-6 sm:p-8 rounded-3xl border border-rose-100 shadow-xl\">\n                <div className=\"flex items-center gap-2 mb-6 text-stone-900 font-serif text-xl font-bold\">\n                  <MessageCircle className=\"w-5 h-5 text-rose-600\" />\n                  <h3>G\341\273\255i L\341\273\235i Ch\303\272c H\341\272\241nh Ph\303\272c</h3>\n                </div>\n\n                <form onSubmit={handleSendWish} className=\"space-y-4\">\n                  <div>\n                    <label htmlFor=\"guestbook-name\" className=\"block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1.5\">\n                      T\303\252n ho\341\272\267c Bi\341\273\207t Danh C\341\273\247a B\341\272\241n *\n                    </label>\n                    <div className=\"relative\">\n                      <User className=\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                      <input\n                        id=\"guestbook-name\"\n                        type=\"text\"\n                        required\n                        placeholder=\"VD: Tu\341\272\245n Anh & Nh\303\263m b\341\272\241n c3\"\n                        value={name}\n                        onChange={(e) => setName(e.target.value)}\n                        className=\"w-full pl-10 pr-4 py-2.5 rounded-xl border border-stone-200 bg-stone-50/50 text-stone-900 text-sm focus:outline-hidden focus:ring-2 focus:ring-rose-500 focus:bg-white transition-all\"\n                      />\n                    </div>\n                  </div>\n\n                  <div>\n                    <label htmlFor=\"guestbook-relationship\" className=\"block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1.5\">\n                      M\341\273\221i Quan H\341\273\207\n                    </label>\n                    <select\n                      id=\"guestbook-relationship\"\n                      value={relationship}\n                      onChange={(e) => setRelationship(e.target.value)}\n                      className=\"w-full px-3.5 py-2.5 rounded-xl border border-stone-200 bg-stone-50/50 text-stone-800 text-sm focus:outline-hidden focus:ring-2 focus:ring-rose-500 focus:bg-white transition-all\"\n                    >\n                      <option value=\"friend\">B\341\272\241n b\303\250 c\341\273\247a d\303\242u r\341\273\203</option>\n                      <option value=\"colleague\">\304\220\341\273\223ng nghi\341\273\207p</option>\n                      <option value=\"family\">Gia \304\221\303\254nh th\303\242n thi\341\272\277t</option>\n                      <option value=\"relative\">H\341\273\215 h\303\240ng hai b\303\252n</option>\n                      <option value=\"other\">Ng\306\260\341\273\235i th\306\260\306\241ng m\341\272\277n kh\303\241c</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label htmlFor=\"guestbook-message\" className=\"block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1.5\">\n                      L\341\273\235i Ch\303\272c Ng\341\273\215t Ng\303\240o *\n                    </label>\n                    <textarea\n                      id=\"guestbook-message\"\n                      required\n                      rows={4}\n                      placeholder=\"Vi\341\272\277t l\341\273\235i ch\303\272c m\341\273\253ng t\341\273\233i Phan Anh & Ng\341\273\215c Y\341\272\277n...\"\n                      value={message}\n                      onChange={(e) => setMessage(e.target.value)}\n                      className=\"w-full p-3 rounded-xl border border-stone-200 bg-stone-50/50 text-stone-900 text-sm focus:outline-hidden focus:ring-2 focus:ring-rose-500 focus:bg-white transition-all resize-none\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    disabled={submitting || !name.trim() || !message.trim()}\n                    className=\"w-full py-3.5 px-5 text-sm font-semibold text-white bg-gradient-to-r from-rose-500 via-rose-600 to-pink-500 hover:from-rose-600 hover:to-pink-600 disabled:opacity-50 rounded-xl shadow-md shadow-rose-500/25 transition-all flex items-center justify-center gap-2 active:scale-95 cursor-pointer\"\n                  >\n                    {submitting ? (\n                      <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                    ) : (\n                      <>\n                        <Send className=\"w-4 h-4\" />\n                        <span>G\341\273\255i L\341\273\235i Ch\303\272c Ngay</span>\n                      </>\n                    )}\n                  </button>\n                </form>\n\n                <div className=\"mt-4 pt-4 border-t border-rose-100 flex items-center justify-between text-xs text-stone-500 font-medium\">\n                  <span className=\"flex items-center gap-1.5\">\n                    <Database className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    {storageMode === \'supabase\' ? \'Supabase Live\' : \'Demo Local Storage\'}\n                  </span>\n                  <span>{wishes.length} l\341\273\235i ch\303\272c</span>\n                </div>\n              </div>\n            </ScrollReveal>\n          </div>\n\n          {/* Right Column: Scrollable List of Wishes */}\n          <div className=\"lg:col-span-7 space-y-4\">\n            <ScrollReveal animation=\"fade-left\" delay={200} duration={700}>\n              <div className=\"flex items-center justify-between px-1\">\n                <h4 className=\"font-serif text-lg font-bold text-stone-900 flex items-center gap-2\">\n                  <Sparkles className=\"w-4 h-4 text-rose-500\" />\n                  L\341\273\235i Ch\303\272c \304\220\303\243 G\341\273\255i ({wishes.length})\n                </h4>\n                <button\n                  onClick={loadWishes}\n                  className=\"text-xs text-rose-600 hover:underline font-semibold cursor-pointer\"\n                >\n                  L\303\240m m\341\273\233i\n                </button>\n              </div>\n\n              {loading ? (\n                <div className=\"text-center py-12 bg-white/95 rounded-3xl border border-rose-100\">\n                  <div className=\"w-6 h-6 border-2 border-rose-500 border-t-transparent rounded-full animate-spin mx-auto mb-2\" />\n                  <p className=\"text-xs text-stone-500\">\304\220ang t\341\272\243i l\341\273\235i ch\303\272c...</p>\n                </div>\n              ) : wishes.length === 0 ? (\n                <div className=\"text-center py-12 bg-white/95 rounded-3xl border border-rose-100 p-6\">\n                  <Smile className=\"w-8 h-8 text-stone-400 mx-auto mb-2\" />\n                  <p className=\"text-sm font-semibold text-stone-700\">Ch\306\260a c\303\263 l\341\273\235i ch\303\272c n\303\240o.</p>\n                  <p className=\"text-xs text-stone-500 mt-1\">H\303\243y l\303\240 ng\306\260\341\273\235i \304\221\341\272\247u ti\303\252n g\341\273\255i l\341\273\235i ch\303\272c t\341\273\221t \304\221\341\272\271p \304\221\341\272\277n \304\221\303\264i uy\303\252n \306\260\306\241ng!</p>\n                </div>\n              ) : (\n                <div className=\"space-y-4 max-h-[580px] overflow-y-auto pr-1\">\n                  {wishes.map((item) => (\n                    <div\n                      key={item.id}\n                      className=\"bg-white/98 backdrop-blur-md p-5 rounded-3xl border border-rose-100 shadow-sm hover:border-rose-300 hover:shadow-md transition-all\"\n                    >\n                      <div className=\"flex items-start justify-between gap-3\">\n                        <div className=\"flex items-center gap-3\">\n                          <div className=\"w-10 h-10 rounded-full bg-gradient-to-br from-rose-100 to-pink-100 text-rose-700 flex items-center justify-center font-bold text-sm font-serif border border-rose-200\">\n                            {item.name.charAt(0).toUpperCase()}\n                          </div>\n                          <div>\n                            <h5 className=\"font-bold text-stone-900 text-sm\">\n                              {item.name}\n                            </h5>\n                            <div className=\"flex items-center gap-1.5 text-xs text-stone-500 mt-0.5\">\n                              <span className=\"font-medium text-rose-600\">{getRelationshipLabel(item.relationship)}</span>\n                              <span aria-hidden=\"true\">\302\267</span>\n                              <span className=\"flex items-center gap-1\">\n                                <Clock className=\"w-3 h-3 text-stone-400\" />\n                                {formatRelativeTime(item.created_at)}\n                              </span>\n                            </div>\n                          </div>\n                        </div>\n\n                        <button\n                          onClick={() => handleLike(item.id)}\n                          className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer ${\n                            likedMap[item.id]\n                              ? \'bg-rose-50 text-rose-600 ring-1 ring-rose-200\'\n                              : \'bg-stone-50 text-stone-600 hover:bg-rose-50 hover:text-rose-600\'\n                          }`}\n                          title=\"Th\341\272\243 tim cho l\341\273\235i ch\303\272c n\303\240y\"\n                        >\n                          <Heart\n                            className={`w-3.5 h-3.5 ${\n                              likedMap[item.id] ? \'fill-rose-500 text-rose-500 scale-110\' : \'text-stone-400\'\n                            }`}\n                          />\n                          <span className=\"tabular-nums font-bold\">\n                            {item.likes_count || 0}\n                          </span>\n                        </button>\n                      </div>\n\n                      <p className=\"mt-3 text-stone-700 text-sm leading-relaxed whitespace-pre-line pl-13\">\n                        {item.message}\n                      </p>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </ScrollReveal>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Guestbook.tsx"
        }
        overwrite: true
      }
    }
