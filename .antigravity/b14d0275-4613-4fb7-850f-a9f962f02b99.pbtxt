    raw_content: "import { WeddingCouple, StoryMilestone, WeddingEvent, GalleryPhoto } from \'../types/wedding\';\n\nexport const weddingCoupleData: WeddingCouple = {\n  groom: {\n    name: \'Phan Anh\',\n    fullName: \'L\303\252 \304\220\341\273\251c Phan Anh\',\n    title: \'Ch\303\272 R\341\273\203\',\n    fatherName: \'L\303\252 \304\220\341\273\251c Minh\',\n    motherName: \'Tr\341\272\247n Th\341\273\213 Mai\',\n    address: \'Qu\341\272\255n Ba \304\220\303\254nh, TP. H\303\240 N\341\273\231i\',\n    phone: \'0912 345 678\',\n    bankInfo: {\n      bankName: \'Vietcombank - Chi nh\303\241nh Th\304\203ng Long\',\n      accountNumber: \'1029384756\',\n      accountName: \'LE DUC PHAN ANH\',\n      qrCodeUrl: \'https://img.vietqr.io/image/VCB-1029384756-compact2.png?amount=0&addInfo=Mung%20cuoi%20Phan%20Anh%20Ngoc%20Yen&accountName=LE%20DUC%20PHAN%20ANH\'\n    }\n  },\n  bride: {\n    name: \'Ng\341\273\215c Y\341\272\277n\',\n    fullName: \'Nguy\341\273\205n Ng\341\273\215c Y\341\272\277n\',\n    title: \'C\303\264 D\303\242u\',\n    fatherName: \'Nguy\341\273\205n V\304\203n H\303\271ng\',\n    motherName: \'Ho\303\240ng Th\341\273\213 Lan\',\n    address: \'Qu\341\272\255n 1, TP. H\341\273\223 Ch\303\255 Minh\',\n    phone: \'0987 654 321\',\n    bankInfo: {\n      bankName: \'Techcombank - Chi nh\303\241nh B\341\272\277n Th\303\240nh\',\n      accountNumber: \'19038472910015\',\n      accountName: \'NGUYEN NGOC YEN\',\n      qrCodeUrl: \'https://img.vietqr.io/image/TCB-19038472910015-compact2.png?amount=0&addInfo=Mung%20cuoi%20Phan%20Anh%20Ngoc%20Yen&accountName=NGUYEN%20NGOC%20YEN\'\n    }\n  },\n  // Wedding date: 28th November 2026, 18:00\n  weddingDate: \'2026-11-28T18:00:00+07:00\',\n  lunarDate: \'Ng\303\240y 20 th\303\241ng 10 n\304\203m B\303\255nh Ng\341\273\215\'\n};\n\nexport const storyMilestones: StoryMilestone[] = [\n  {\n    id: \'story-1\',\n    year: \'2021\',\n    date: \'15 Th\303\241ng 10, 2021\',\n    title: \'L\341\272\247n \304\220\341\272\247u G\341\272\267p G\341\273\241\',\n    description: \'M\341\273\231t bu\341\273\225i chi\341\273\201u thu trong l\303\240nh, \303\241nh m\341\272\257t v\303\264 t\303\254nh ch\341\272\241m nhau v\303\240 c\303\242u chuy\341\273\207n t\303\254nh y\303\252u b\341\272\257t \304\221\341\272\247u t\341\273\253 m\341\273\231t cu\341\273\221n s\303\241ch ch\303\272ng m\303\254nh c\303\271ng y\303\252u th\303\255ch.\',\n    imageUrl: \'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=800&q=80\',\n    imageAlt: \'L\341\272\247n \304\221\341\272\247u g\341\272\267p g\341\273\241\',\n    location: \'H\303\240 N\341\273\231i\'\n  },\n  {\n    id: \'story-2\',\n    year: \'2022\',\n    date: \'14 Th\303\241ng 02, 2022\',\n    title: \'L\341\273\235i T\341\273\217 T\303\254nh Ng\341\273\215t Ng\303\240o\',\n    description: \'Sau chu\341\273\227i ng\303\240y c\303\271ng nhau s\341\272\273 chia m\341\273\215i vui bu\341\273\223n, ch\303\240ng \304\221\303\243 l\341\272\245y h\341\272\277t can \304\221\341\272\243m ng\341\273\217 l\341\273\235i y\303\252u n\303\240ng v\341\273\233i m\341\273\231t b\303\263 hoa t\306\260\306\241i tinh kh\303\264i.\',\n    imageUrl: \'https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?auto=format&fit=crop&w=800&q=80\',\n    imageAlt: \'L\341\273\235i t\341\273\217 t\303\254nh ng\341\273\215t ng\303\240o\',\n    location: \'Ph\341\273\221 C\341\273\225\'\n  },\n  {\n    id: \'story-3\',\n    year: \'2023\',\n    date: \'20 Th\303\241ng 07, 2023\',\n    title: \'Chuy\341\272\277n \304\220i Xa \304\220\341\272\247u Ti\303\252n\',\n    description: \'Chuy\341\272\277n vi vu kh\303\241m ph\303\241 cung \304\221\306\260\341\273\235ng s\306\260\306\241ng m\303\271 \304\220\303\240 L\341\272\241t. C\303\271ng nhau ng\341\272\257m b\303\254nh minh v\303\240 nh\341\272\255n ra ng\306\260\341\273\235i \341\272\245y ch\303\255nh l\303\240 m\341\272\243nh gh\303\251p tr\341\273\215n v\341\272\271n c\341\273\