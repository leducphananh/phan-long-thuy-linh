  user_input {
    user_response: "\304\220\303\263ng vai l\303\240 m\341\273\231t chuy\303\252n gia l\341\272\255p tr\303\254nh Fullstack Web. H\303\243y vi\341\272\277t code ho\303\240n ch\341\273\211nh \304\221\341\273\203 x\303\242y d\341\273\261ng m\341\273\231t trang web thi\341\273\207p c\306\260\341\273\233i (Wedding Invitation Website) s\341\273\255 d\341\273\245ng NextJS (App Router), React, Tailwind CSS cho ph\341\272\247n giao di\341\273\207n v\303\240 Supabase \304\221\341\273\203 l\303\240m backend l\306\260u tr\341\273\257 d\341\273\257 li\341\273\207u. \n\nGiao di\341\273\207n c\341\272\247n mang phong c\303\241ch l\303\243ng m\341\272\241n, hi\341\273\207n \304\221\341\272\241i, t\341\273\221i \306\260u hi\341\273\203n th\341\273\213 t\341\273\221t tr\303\252n thi\341\272\277t b\341\273\213 di \304\221\341\273\231ng (mobile-first) v\303\240 c\303\263 hi\341\273\207u \341\273\251ng cu\341\273\231n trang m\306\260\341\273\243t m\303\240 (smooth scroll). Trang web (Single Page Application) c\341\272\247n bao g\341\273\223m c\303\241c ph\341\272\247n sau:\n\n1. Hero Section (Trang b\303\254a): Hi\341\273\203n th\341\273\213 t\303\252n c\303\264 d\303\242u - ch\303\272 r\341\273\203, ng\303\240y c\306\260\341\273\233i, \341\272\243nh n\341\273\201n \304\221\341\272\271p v\303\240 m\341\273\231t \304\221\341\273\223ng h\341\273\223 \304\221\341\272\277m ng\306\260\341\273\243c \304\221\341\272\277n ng\303\240y t\341\273\225 ch\341\273\251c.\n2. Chuy\341\273\207n ch\303\272ng m\303\254nh (Our Story): Thi\341\272\277t k\341\272\277 d\306\260\341\273\233i d\341\272\241ng UI Timeline hi\341\273\203n th\341\273\213 c\303\241c c\341\273\231t m\341\273\221c quan tr\341\273\215ng trong qu\303\241 tr\303\254nh y\303\252u nhau k\303\250m h\303\254nh \341\272\243nh v\303\240 m\303\264 t\341\272\243 ng\341\272\257n.\n3. Thi\341\273\207p m\341\273\235i (Invitation): Chi ti\341\272\277t th\341\273\235i gian, \304\221\341\273\213a \304\221i\341\273\203m t\341\273\225 ch\341\273\251c (l\341\273\205 t\303\242n h\303\264n, ti\341\273\207c c\306\260\341\273\233i), c\303\263 t\303\255ch h\341\273\243p nh\303\272ng b\341\272\243n \304\221\341\273\223 Google Maps v\303\240 n\303\272t \"Th\303\252m v\303\240o L\341\273\213ch\".\n4. Album \341\272\243nh (Gallery): Hi\341\273\203n th\341\273\213 \341\272\243nh c\306\260\341\273\233i theo d\341\272\241ng l\306\260\341\273\233i (Masonry grid layout) ho\341\272\267c slider, c\303\263 h\341\273\227 tr\341\273\243 click v\303\240o \304\221\341\273\203 xem \341\272\243nh ph\303\263ng to (Lightbox).\n5. X\303\241c nh\341\272\255n tham gia (RSVP): M\341\273\231t form nh\341\272\255p li\341\273\207u bao g\341\273\223m: T\303\252n kh\303\241ch m\341\273\235i, S\341\273\221 \304\221i\341\273\207n tho\341\272\241i, L\341\273\261a ch\341\273\215n tham d\341\273\261 (C\303\263/Kh\303\264ng), v\303\240 S\341\273\221 ng\306\260\341\273\235i \304\221i c\303\271ng. Vi\341\272\277t logic t\303\255ch h\341\273\243p Supabase Client \304\221\341\273\203 l\306\260u d\341\273\257 li\341\273\207u n\303\240y v\303\240o database.\n6. S\341\273\225 l\306\260u b\303\272t (Guestbook): Form \304\221\341\273\203 kh\303\241ch g\341\273\255i l\341\273\235i ch\303\272c v\303\240 m\341\273\231t danh s\303\241ch cu\341\273\231n hi\341\273\203n th\341\273\213 c\303\241c l\341\273\235i ch\303\272c t\341\273\253 nh\341\273\257ng ng\306\260\341\273\235i kh\303\241c. D\341\273\257 li\341\273\207u n\303\240y c\305\251ng c\341\272\247n \304\221\306\260\341\273\243c \304\221\341\273\215c v\303\240 ghi th\303\264ng qua Supabase.\n\nY\303\252u c\341\272\247u k\341\273\271 thu\341\272\255t chi ti\341\272\277t \304\221\341\273\221i v\341\273\233i output:\n- Cung c\341\272\245p c\341\272\245u tr\303\272c th\306\260 m\341\273\245c d\341\273\261 \303\241n \304\221\341\272\247y \304\221\341\273\247.\n- Chia nh\341\273\217 code th\303\240nh c\303\241c file components ri\303\252ng bi\341\273\207t (v\303\255 d\341\273\245: Hero.tsx, Story.tsx, RSVPForm.tsx...) \304\221\341\273\203 d\341\273\205 b\341\272\243o tr\303\254.\n- Cung c\341\272\245p \304\221o\341\272\241n m\303\243 SQL (DDL) \304\221\341\273\203 t\341\272\241o c\303\241c b\341\272\243ng `rsvp` v\303\240 `guestbook` tr\303\252n Supabase.\n- Code ph\341\272\243i g\341\273\215n g\303\240ng, s\341\273\255 d\341\273\245ng TypeScript, c\303\263 comment gi\341\272\243i th\303\255ch r\303\265 r\303\240ng c\303\241c h\303\240m x\341\273\255 l\303\275 logic v\303\240 s\341\272\265n s\303\240ng \304\221\341\273\203 t\303\264i c\303\263 th\341\273\203 deploy tr\341\273\261c ti\341\272\277p l\303\252n Vercel."
    items {
      text: "\304\220\303\263ng vai l\303\240 m\341\273\231t chuy\303\252n gia l\341\272\255p tr\303\254nh Fullstack Web. H\303\243y vi\341\272\277t code ho\303\240n ch\341\273\211nh \304\221\341\273\203 x\303\242y d\341\273\261ng m\341\273\231t trang web thi\341\273\207p c\306\260\341\273\233i (Wedding Invitation Website) s\341\273\255 d\341\273\245ng NextJS (App Router), React, Tailwind CSS cho ph\341\272\247n giao di\341\273\207n v\303\240 Supabase \304\221\341\273\203 l\303\240m backend l\306\260u tr\341\273\257 d\341\273\257 li\341\273\207u. \n\nGiao di\341\273\207n c\341\272\247n mang phong c\303\241ch l\303\243ng m\341\272\241n, hi\341\273\207n \304\221\341\272\241i, t\341\273\221i \306\260u hi\341\273\203n th\341\273\213 t\341\273\221t tr\303\252n thi\341\272\277t b\341\273\213 di \304\221\341\273\231ng (mobile-first) v\303\240 c\303\263 hi\341\273\207u \341\273\251ng cu\341\273\231n trang m\306\260\341\273\243t m\303\240 (smooth scroll). Trang web (Single Page Application) c\341\272\247n bao g\341\273\223m c\303\241c ph\341\272\247n sau:\n\n1. Hero Section (Trang b\303\254a): Hi\341\273\203n th\341\273\213 t\303\252n c\303\264 d\303\242u - ch\303\272 r\341\273\203, ng\303\240y c\306\260\341\273\233i, \341\272\243nh n\341\273\201n \304\221\341\272\271p v\303\240 m\341\273\231t \304\221\341\273\223ng h\341\273\223 \304\221\341\272\277m ng\306\260\341\273\243c \304\221\341\272\277n ng\303\240y t\341\273\225 ch\341\273\251c.\n2. Chuy\341\273\207n ch\303\272ng m\303\254nh (Our Story): Thi\341\272\277t k\341\272\277 d\306\260\341\273\233i d\341\272\241ng UI Timeline hi\341\273\203n th\341\273\213 c\303\241c c\341\273\231t m\341\273\221c quan tr\341\273\215ng trong qu\303\241 tr\303\254nh y\303\252u nhau k\303\250m h\303\254nh \341\272\243nh v\303\240 m\303\264 t\341\272\243 ng\341\272\257n.\n3. Thi\341\273\207p m\341\273\235i (Invitation): Chi ti\341\272\277t th\341\273\235i gian, \304\221\341\273\213a \304\221i\341\273\203m t\341\273\225 ch\341\273\251c (l\341\273\205 t\303\242n h\303\264n, ti\341\273\207c c\306\260\341\273\233i), c\303\263 t\303\255ch h\341\273\243p nh\303\272ng b\341\272\243n \304\221\341\273\223 Google Maps v\303\240 n\303\272t \"Th\303\252m v\303\240o L\341\273\213ch\".\n4. Album \341\272\243nh (Gallery): Hi\341\273\203n th\341\273\213 \341\272\243nh c\306\260\341\273\233i theo d\341\272\241ng l\306\260\341\273\233i (Masonry grid layout) ho\341\272\267c slider, c\303\263 h\341\273\227 tr\341\273\243 click v\303\240o \304\221\341\273\203 xem \341\272\243nh ph\303\263ng to (Lightbox).\n5. X\303\241c nh\341\272\255n tham gia (RSVP): M\341\273\231t form nh\341\272\255p li\341\273\207u bao g\341\273\223m: T\303\252n kh\303\241ch m\341\273\235i, S\341\273\221 \304\221i\341\273\207n tho\341\272\241i, L\341\273\261a ch\341\273\215n tham d\341\273\261 (C\303\263/Kh\303\264ng), v\303\240 S\341\273\221 ng\306\260\341\273\235i \304\221i c\303\271ng. Vi\341\272\277t logic t\303\255ch h\341\273\243p Supabase Client \304\221\341\273\203 l\306\260u d\341\273\257 li\341\273\207u n\303\240y v\303\240o database.\n6. S\341\273\225 l\306\260u b\303\272t (Guestbook): Form \304\221\341\273\203 kh\303\241ch g\341\273\255i l\341\273\235i ch\303\272c v\303\240 m\341\273\231t danh s\303\241ch cu\341\273\231n hi\341\273\203n th\341\273\213 c\303\241c l\341\273\235i ch\303\272c t\341\273\253 nh\341\273\257ng ng\306\260\341\273\235i kh\303\241c. D\341\273\257 li\341\273\207u n\303\240y c\305\251ng c\341\272\247n \304\221\306\260\341\273\243c \304\221\341\273\215c v\303\240 ghi th\303\264ng qua Supabase.\n\nY\303\252u c\341\272\247u k\341\273\271 thu\341\272\255t chi ti\341\272\277t \304\221\341\273\221i v\341\273\233i output:\n- Cung c\341\272\245p c\341\272\245u tr\303\272c th\306\260 m\341\273\245c d\341\273\261 \303\241n \304\221\341\272\247y \304\221\341\273\247.\n- Chia nh\341\273\217 code th\303\240nh c\303\241c file components ri\303\252ng bi\341\273\207t (v\303\255 d\341\273\245: Hero.tsx, Story.tsx, RSVPForm.tsx...) \304\2