    end_line: 24
    content: "import React, { useState, useEffect } from \'react\';\nimport { Calendar, MapPin, Heart, ChevronDown } from \'lucide-react\';\nimport { WeddingCouple } from \'../types/wedding\';\n\ninterface HeroProps {\n  couple: WeddingCouple;\n  onRSVPClick: () => void;\n  onGuestbookClick: () => void;\n}\n\ninterface TimeLeft {\n  days: number;\n  hours: number;\n  minutes: number;\n  seconds: number;\n  isPast: boolean;\n}\n\nexport const Hero: React.FC<HeroProps> = ({\n  couple,\n  onRSVPClick,\n  onGuestbookClick\n}) => {\n  const targetDate = new Date(couple.weddingDate).getTime();\n"
    raw_content: "import React, { useState, useEffect } from \'react\';\nimport { Calendar, MapPin, Heart, ChevronDown } from \'lucide-react\';\nimport { WeddingCouple } from \'../types/wedding\';\n\ninterface HeroProps {\n  couple: WeddingCouple;\n  onRSVPClick: () => void;\n  onGuestbookClick: () => void;\n}\n\ninterface TimeLeft {\n  days: number;\n  hours: number;\n  minutes: number;\n  seconds: number;\n  isPast: boolean;\n}\n\nexport const Hero: React.FC<HeroProps> = ({\n  couple,\n  onRSVPClick,\n  onGuestbookClick\n}) => {\n  const targetDate = new Date(couple.weddingDate).getTime();\n\n  const calculateTimeLeft = (): TimeLeft => {\n    const now = new Date().getTime();\n    const difference = targetDate - now;\n\n    if (difference <= 0) {\n      return { days: 0, hours: 0, minutes: 0, seconds: 0, isPast: true };\n    }\n\n    return {\n      days: Math.floor(difference / (1000 * 60 * 60 * 24)),\n      hours: Math.floor((difference / (1000 * 60 * 60)) % 24),\n      minutes: Math.floor((difference / 1000 / 60) % 60),\n      seconds: Math.floor((difference / 1000) % 60),\n      isPast: false,\n    };\n  };\n\n  const [timeLeft, setTimeLeft] = useState<TimeLeft>(calculateTimeLeft());\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setTimeLeft(calculateTimeLeft());\n    }, 1000);\n    return () => clearInterval(timer);\n  }, [targetDate]);\n\n  return (\n    <section id=\"hero\" className=\"relative min-h-screen flex items-center justify-center overflow-hidden\">\n      {/* Background Image with warm romantic lighting & layered gradient scrim */}\n      <div className=\"absolute inset-0 z-0\">\n        <img\n          src=\"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=2000&q=85\"\n          alt=\"H\341\272\243i Nam & Kh\303\241nh Linh Wedding Banner\"\n          referrerPolicy=\"no-referrer\"\n          className=\"w-full h-full object-cover object-center transform scale-105 transition-transform duration-1000 ease-out\"\n        />\n        {/* Measured scrim ensuring high contrast WCAG AA readability */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-900/50 to-stone-950/70\" />\n        <div className=\"absolute inset-0 bg-stone-900/20 backdrop-blur-[1px]\" />\n      </div>\n\n      {/* Decorative floral lace vignette accents */}\n      <div className=\"absolute inset-0 pointer-events-none z-1 border-[12px] sm:border-[16px] border-white/10 m-2 sm:m-4 rounded-3xl\" />\n\n      {/* Hero Content */}\n      <div className=\"relative z-10 max-w-4xl mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center text-white flex flex-col items-center\">\n        {/* Subtle romantic script kicker */}\n        <p className=\"font-script text-2xl sm:text-3xl lg:text-4xl text-rose-200 tracking-wide mb-2 drop-shadow-md\">\n          Save the Date\n        </p>\n\n        {/* Clean subtitle tag */}\n        <div className=\"flex items-center gap-2 text-xs sm:text-sm tracking-[0.25em] uppercase text-stone-200/90 font-medium mb-4\">\n          <span>H\303\264n L\341\273\205 Thi\303\252ng Li\303\252ng</span>\n          <span aria-hidden=\"true\">\302\267</span>\n          <span>Tr\303\242n Tr\341\273\215ng K\303\255nh B\303\241o</span>\n        </div>\n\n        {/* Couple Names */}\n        <div className=\"mb-6\">\n          <h1 className=\"font-serif text-4xl sm:text-6xl md:text-7xl font-bold tracking-normal leading-tight text-white drop-shadow-lg text-balance\">\n            {couple.groom.name} <span className=\"font-script text-rose-300 font-normal px-2 text-4xl sm:text-6xl md:text-7xl\">&</span> {couple.bride.name}\n          </h1>\n          <p className=\"mt-2 text-xs sm:text-sm text-stone-300 tracking-widest font-sans uppercase\">\n            {couple.groom.fullName} &amp; {couple.bride.fullName}\n          </p>\n        </div>\n\n        {/* Date and Venue information */}\n        <div className=\"flex flex-wrap items-center justify-center gap-y-2 gap-x-4 text-xs sm:text-sm text-stone-200 mb-8 max-w-xl\">\n          <span className=\"flex items-center gap-1.5\">\n            <Calendar className=\"w-4 h-4 text-rose-300\" />\n            28 Th\303\241ng 11, 2026\n          </span>\n          <span aria-hidden=\"true\" className=\"text-stone-400\">\302\267</span>\n          <span className=\"text-stone-300\">\n            {couple.lunarDate}\n          </span>\n          <span aria-hidden=\"true\" className=\"text-stone-400\">\302\267</span>\n          <span className=\"flex items-center gap-1.5\">\n            <MapPin className=\"w-4 h-4 text-rose-300\" />\n            TP. H\341\273\223 Ch\303\255 Minh\n          </span>\n        </div>\n\n        {/* Countdown Timer Card with ScrollReveal */}\n        <ScrollReveal animation=\"zoom-in\" delay={200} duration={800}>\n          <div className=\"w-full max-w-lg mb-10 bg-white/10 backdrop-blur-md border border-white/20 p-4 sm:p-6 rounded-3xl shadow-2xl\">\n            <div className=\"text-center mb-3\">\n              <p className=\"text-xs uppercase tracking-widest text-rose-200 font-medium flex items-center justify-center gap-1.5\">\n                <Heart className=\"w-3.5 h-3.5 fill-rose-300 text-rose-300 inline\" />\n                \304\220\341\272\277m ng\306\260\341\273\243c \304\221\341\272\277n ng\303\240y h\341\272\241nh ph\303\272c\n                <Heart className=\"w-3.5 h-3.5 fill-rose-300 text-rose-300 inline\" />\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-4 gap-2 sm:gap-4\">\n              <div className=\"flex flex-col items-center justify-center p-2.5 sm:p-3 bg-stone-900/40 rounded-2xl border border-white/10\">\n                <span className=\"font-serif text-2xl sm:text-4xl font-bold text-white tabular-nums\">\n                  {String(timeLeft.days).padStart(2, \'0\')}\n                </span>\n                <span className=\"text-[10px] sm:text-xs text-stone-300 uppercase tracking-wider mt-1\">\n                  Ng\303\240y\n                </span>\n              </div>\n\n              <div className=\"flex flex-col items-center justify-center p-2.5 sm:p-3 bg-stone-900/40 rounded-2xl border border-white/10\">\n                <span className=\"font-serif text-2xl sm:text-4xl font-bold text-white tabular-nums\">\n                  {String(timeLeft.hours).padStart(2, \'0\')}\n                </span>\n                <span className=\"text-[10px] sm:text-xs text-stone-300 uppercase tracking-wider mt-1\">\n                  Gi\341\273\235\n                </span>\n              </div>\n\n              <div className=\"flex flex-col items-center justify-center p-2.5 sm:p-3 bg-stone-900/40 rounded-2xl border border-white/10\">\n                <span className=\"font-serif text-2xl sm:text-4xl font-bold text-white tabular-nums\">\n                  {String(timeLeft.minutes).padStart(2, \'0\')}\n                </span>\n                <span className=\"text-[10px] sm:text-xs text-stone-300 uppercase tracking-wider mt-1\">\n                  Ph\303\272t\n                </span>\n              </div>\n\n              <div className=\"flex flex-col items-center justify-center p-2.5 sm:p-3 bg-stone-900/40 rounded-2xl border border-white/10\">\n                <span className=\"font-serif text-2xl sm:text-4xl font-bold text-rose-300 tabular-nums\">\n                  {String(timeLeft.seconds).padStart(2, \'0\')}\n                </span>\n                <span className=\"text-[10px] sm:text-xs text-stone-300 uppercase tracking-wider mt-1\">\n                  Gi\303\242y\n                </span>\n              </div>\n            </div>\n          </div>\n        </ScrollReveal>\n\n        {/* Action Buttons with ScrollReveal */}\n        <ScrollReveal animation=\"fade-up\" delay={350} duration={700}>\n          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto\">\n            <button\n              onClick={onRSVPClick}\n              className=\"w-full sm:w-auto px-7 py-3 text-sm font-semibold text-white bg-rose-600 rounded-xl hover:bg-rose-700 transition-all transform hover:-translate-y-0.5 shadow-lg shadow-rose-900/30 whitespace-nowrap active:scale-95\"\n            >\n              X\303\241c Nh\341\272\255n Tham D\341\273\261 (RSVP)\n            </button>\n            <button\n              onClick={onGuestbookClick}\n              className=\"w-full sm:w-auto px-7 py-3 text-sm font-semibold text-stone-100 bg-white/15 border border-white/30 rounded-xl hover:bg-white/25 backdrop-blur-xs transition-all whitespace-nowrap active:scale-95\"\n            >\n              G\341\273\255i L\341\273\235i Ch\303\272c H\341\272\241nh Ph\303\272c\n            </button>\n          </div>\n        </ScrollReveal>\n\n        {/* Romantic quote */}\n        <p className=\"mt-12 text-xs sm:text-sm text-stone-300/80 italic font-cormorant max-w-lg leading-relaxed\">\n          &ldquo;G\341\272\267p g\341\273\241 l\303\240 duy\303\252n ph\341\272\255n, n\341\272\257m tay l\303\240 \304\221\341\273\213nh m\341\273\207nh, v\303\240 c\303\271ng nhau gi\303\240 \304\221i l\303\240 l\341\273\235i h\341\273\251a tr\341\273\215n \304\221\341\273\235i.&rdquo;\n        </p>\n\n        {/* Scroll indicator */}\n        <a\n          href=\"#story\"\n          aria-label=\"Cu\341\273\231n xu\341\273\221ng xem c\303\242u chuy\341\273\207n\"\n          className=\"mt-8 text-stone-300 hover:text-white transition-colors animate-bounce p-2\"\n        >\n          <ChevronDown className=\"w-6 h-6\" />\n        </a>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 197
    num_bytes: 8852
  }
}
